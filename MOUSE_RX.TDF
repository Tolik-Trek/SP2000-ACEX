TITLE "Early XA serial mouse receiver";
SUBDESIGN MOUSE_RX
(
    CLK42, SAMPLE_PHASE, SERIAL_DATA : INPUT;
    ADDR8, ADDR10 : INPUT;
    READ_BYTE[7..0] : OUTPUT;
)
VARIABLE
    MOUSE_CLOCK, DATA_DELAY_R : DFF;

    BIT_EQUAL, SAMPLE_TICK, PACKET_TICK, STATE_TICK,
    X_TICK, Y_TICK : NODE;

    BIT_COUNT[3..0] : DFF;

    RECEIVE[9..0], HEADER[5..0], STATE[1..0] : DFFE;

    SUM_X[7..0], SUM_Y[7..0] : DFFE;

    DELTA_X[7..0], DELTA_Y[7..0], READ_AXIS[7..0] : NODE;

    READ_LOW_BASE[1..0] : NODE;

BEGIN
    -- Architecture follows OLD MOUSE.TDF:20..75, with the actual early8-bit
    -- accumulator and signed5-bit packet lanes. No reset was present on sums.
    MOUSE_CLOCK.clk = CLK42; MOUSE_CLOCK = SAMPLE_PHASE;
    DATA_DELAY_R.clk = MOUSE_CLOCK; DATA_DELAY_R = SERIAL_DATA;
    BIT_EQUAL = LCELL(!(SERIAL_DATA $ DATA_DELAY_R));
    BIT_COUNT[].clk = MOUSE_CLOCK; BIT_COUNT[].clrn = BIT_EQUAL;
    IF BIT_COUNT[] == 12 THEN BIT_COUNT[] = 0;
    ELSE BIT_COUNT[] = BIT_COUNT[] + 1; END IF;
    SAMPLE_TICK = LCELL(BIT_COUNT[] == 4);
    PACKET_TICK = LCELL(SAMPLE_TICK or !RECEIVE0);
    RECEIVE[].clk = MOUSE_CLOCK; RECEIVE[].ena = PACKET_TICK;
    RECEIVE[] = (SERIAL_DATA,RECEIVE[9..1]) or !RECEIVE0;
    STATE_TICK = LCELL(!RECEIVE0);
    STATE[].clk = MOUSE_CLOCK; STATE[].ena = STATE_TICK;
    STATE[] = (STATE0,RECEIVE7);
    HEADER[].clk = MOUSE_CLOCK;
    HEADER[].ena = LCELL(RECEIVE7 & !RECEIVE0);
    HEADER[] = RECEIVE[6..1];
    -- The early packet contributes3 low payload bits and2 saved header bits.
    -- Each8-bit word is the signed extension of that5-bit displacement.
    DELTA_X[] = (HEADER2,HEADER2,HEADER2,HEADER2,HEADER3,RECEIVE1,RECEIVE2,RECEIVE3);
    DELTA_Y[] = (HEADER0,HEADER0,HEADER0,HEADER0,HEADER1,RECEIVE1,RECEIVE2,RECEIVE3);
    X_TICK = LCELL(STATE1 & !STATE0 & !RECEIVE7 & !RECEIVE0);
    Y_TICK = LCELL(!STATE1 & STATE0 & !RECEIVE7 & !RECEIVE0);
    SUM_X[].clk = MOUSE_CLOCK; SUM_X[].ena = X_TICK;
    SUM_Y[].clk = MOUSE_CLOCK; SUM_Y[].ena = Y_TICK;
    SUM_X[] = SUM_X[] + DELTA_X[];
    SUM_Y[] = SUM_Y[] + DELTA_Y[];
    -- Axis-X is read in complemented phase. The actual two low-bit boundary
    -- stages select buttons when ADDR8=0; upper6 bits then read as ones.
    IF ADDR10 THEN READ_AXIS[] = !SUM_X[]; ELSE READ_AXIS[] = SUM_Y[]; END IF;
    FOR bit IN 2 TO 7 GENERATE
        READ_BYTE[bit] = LCELL(READ_AXIS[bit] or !ADDR8);
    END GENERATE;
    READ_LOW_BASE0 = LCELL((ADDR8 & ADDR10 & !SUM_X0) or (!HEADER4 & !ADDR8));
    READ_LOW_BASE1 = LCELL((ADDR8 & ADDR10 & !SUM_X1) or (!HEADER5 & !ADDR8));
    READ_BYTE0 = LCELL((ADDR8 & !ADDR10 & SUM_Y0) or READ_LOW_BASE0);
    READ_BYTE1 = LCELL((ADDR8 & !ADDR10 & SUM_Y1) or READ_LOW_BASE1);
END;
