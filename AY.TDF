-- Early AY engine: data/address ports, register microcode RAM and tone/noise/envelope state. RAM contents are taken from this ACX reverse.
-- Named control/data banks and preserved physical helpers; independent source review pending.
INCLUDE "lpm_ram_dp";
INCLUDE "lpm_ram_dq";
SUBDESIGN ay
(
	/WR : INPUT;
	D[7..0] : INPUT;
	/RESET : INPUT;
	TG42 : INPUT;
	CT[5..0] : INPUT;
	CTH[5..0] : INPUT;
	DCPP[7..0] : INPUT;
	IO_WINDOW : INPUT;
	PORT_XXX10000 : INPUT;
	PORT_XXX10001 : INPUT;
	PORT_C2_CA_DATA[4..0] : INPUT;
	AY_AX[7..0] : OUTPUT;
	AY_DQX[3..0] : OUTPUT;
	AY_TONE23_SLOT : OUTPUT;
	AY_TONE12_SLOT : OUTPUT;
	AY_SAMPLE_END : OUTPUT;
	AY_SAMPLE_START : OUTPUT;
	AY_PHASE2_FALL : OUTPUT;
	AY_DD[7..0] : OUTPUT;
)
VARIABLE
	ROM : lpm_ram_dq WITH (lpm_width=8,lpm_widthad=8,lpm_file="AY.MIF");
	AY_CODE[7..0] : NODE;
	BD[7..0] : NODE;
	AY_ADR[3..0] : NODE;
	AY_DAT[7..0] : NODE;
	AY_DI[7..0] : NODE;
	AY_AX[7..0] : NODE;
	AY_MIXER[5..0] : NODE;
	AY_GF[3..0] : NODE;
	AY_VA[3..0] : NODE;
	AY_AA[3..0] : NODE;
	AY_AMP[3..0] : NODE;
	AY_DQX[3..0] : NODE;
	AY_SH_N[16..0] : NODE;
	AY_ENVELOPE_CODE : NODE;
	AY_TONE_CODE_LO : NODE;
	AY_MIXER_CODE_LO : NODE;
	AY_TONE3_CODE_LO : NODE;
	AY_TONE_WR : NODE;
	AY_MIXER_WR : NODE;
	AY_TONE3_WR : NODE;
	AY_OUT1 : NODE;
	AY_CH12_MUX : NODE;
	AY_CH2_GATE : NODE;
	AY_CH1_GATE : NODE;
	AY_BEEPER_SAMPLE : NODE;
	AY_FORM_CODE_LO : NODE;
	AY_NOISE_CODE_LO : NODE;
	AY_TONE2_CODE_LO : NODE;
	AY_NOISE_WR : NODE;
	AY_TONE2_WR : NODE;
	AY_TONE1_WR : NODE;
	AY_TONE1_CODE_LO : NODE;
	AY_FORM_WR : NODE;
	AY_CH_MIX : NODE;
	AY_OUT3 : NODE;
	AY_CH3_GATE : NODE;
	AY_TONE3_WR_D : NODE;
	AY_OUT2 : NODE;
	AY_TONE3_SLOT_1 : NODE;
	AY_TONE23_SLOT : NODE;
	AY_NOISE_TONE2_SLOT : NODE;
	AY_TONE1_WR_D : NODE;
	AY_TONE12_SLOT : NODE;
	AY_TONE1_SLOT : NODE;
	AY_SAMPLE_END : NODE;
	AY_F_RES : NODE;
	AY_F_RES_D : NODE;
	AY_SAMPLE_START_LO : NODE;
	AY_CCC7_N : NODE;
	AY_SAMPLE_END_LO : NODE;
	AY_SAMPLE_START : NODE;
	AY_AX3_N : NODE;
	AY_BD_HIGH_CLRN : NODE;
	AY_BD4_CLRN : NODE;
	AY_CCC3 : NODE;
	AY_AX2_N : NODE;
	AY_AAX0 : NODE;
	AY_PHASE2_FALL : NODE;
	AY_AX0_N : NODE;
	AY_CCC2 : NODE;
	AY_CCC6 : NODE;
	AY_AX1_N : NODE;
	AY_CCC4 : NODE;
	AY_CCC1 : NODE;
	AY_CODE5_N_D : NODE;
	AY_BORROW1 : NODE;
	AY_CODE7_D : NODE;
	AY_SUB_ONE : NODE;
	AY_BORROW3_N : NODE;
	AY_DATA_LO_ZERO : NODE;
	AY_BINV : NODE;
	AY_BBLK : NODE;
	AY_CCC0 : NODE;
	AY_CX_ENA : NODE;
	AY_MEM_WRITE_N : NODE;
	AY_CX_CLEAR : NODE;
	AY_DAT_WR : NODE;
	AY_DAT_WR_D : NODE;
	AY_NOISE_ENA : NODE;
	AY_DAT_ENA : NODE;
	AY_TYPE010 : NODE;
	AY_VAR : NODE;
	AY_ABLK : NODE;
	AY_VX : NODE;
	AY_ENVELOPE_WR : NODE;
	AY_C : NODE;
	AY_BORROW4 : NODE;
	AY_CXX_N : NODE;
	AY_CX_N : NODE;
	AY_DATA_ZERO0 : NODE;
	AY_CX_HOLD : NODE;
	AY_CX_RELOAD : NODE;
	AY_CODE0_D : NODE;
	AY_DATA_ZERO1 : NODE;
	AY_CXX_HOLD : NODE;
	AY_ADDR_PORT : NODE;
	AY_DATA_PORT : NODE;
	AY_A_WR : NODE;
	AY_WR : NODE;
	AY_D_WR : NODE;
	BWR : NODE;
	AY_F_R1 : NODE;
	AY_CCC5 : NODE;
	AY_ENV_CARRY1 : CARRY;
	AY_ENV_CARRY2 : CARRY;
	AY_ENV_CARRY3 : CARRY;
	AY_ENV_CARRY4 : CARRY;
	AY_ENV_CARRY5 : CARRY;
	AY_SUB_BORROW1 : CARRY;
	AY_SUB_BORROW2 : CARRY;
	AY_SUB_BORROW3 : CARRY;
	AY_SUB_BORROW4 : CARRY;
	AY_DD[7..0] : NODE;
	-- Explicit instances preserve FF source names across module ports.
	AY_AA_R[3..0] : DFFE;
	AY_AAX0_R : DFFE;
	AY_ABLK_R : DFFE;
	AY_ADDR_PORT_R : DFFE;
	AY_ADR_R[3..0] : DFFE;
	AY_AMP_R[3..0] : DFFE;
	AY_A_WR_R : DFFE;
	AY_BBLK_R : DFFE;
	AY_BEEPER_SAMPLE_R : DFFE;
	AY_BINV_R : DFFE;
	AY_C_R : DFFE;
	AY_CCC0_R : DFFE;
	AY_CCC1_R : DFFE;
	AY_CCC2_R : DFFE;
	AY_CCC3_R : DFFE;
	AY_CCC4_R : DFFE;
	AY_CCC5_R : DFFE;
	AY_CCC6_R : DFFE;
	AY_CCC7_N_R : DFFE;
	AY_CH_MIX_R : DFFE;
	AY_CODE0_D_R : DFFE;
	AY_CODE5_N_D_R : DFFE;
	AY_CODE7_D_R : DFFE;
	AY_CXX_N_R : DFFE;
	AY_CX_CLEAR_R : DFFE;
	AY_CX_ENA_R : DFFE;
	AY_CX_N_R : DFFE;
	AY_CX_RELOAD_R : DFFE;
	AY_DAT_R[7..0] : DFFE;
	AY_DATA_PORT_R : DFFE;
	AY_DAT_WR_R : DFFE;
	AY_DAT_WR_D_R : DFFE;
	AY_DD_R[7..0] : DFFE;
	AY_DQX_R[3..0] : DFFE;
	AY_D_WR_R : DFFE;
	AY_ENVELOPE_WR_R : DFFE;
	AY_FORM_WR_R : DFFE;
	AY_F_R1_R : DFFE;
	AY_F_RES_R : DFFE;
	AY_F_RES_D_R : DFFE;
	AY_GF_R[3..0] : DFFE;
	AY_MIXER_R[5..0] : DFFE;
	AY_MIXER_WR_R : DFFE;
	AY_NOISE_TONE2_SLOT_R : DFFE;
	AY_NOISE_WR_R : DFFE;
	AY_OUT1_R : DFFE;
	AY_OUT2_R : DFFE;
	AY_OUT3_R : DFFE;
	AY_SAMPLE_END_R : DFFE;
	AY_SAMPLE_START_R : DFFE;
	AY_SH_N_R[16..0] : DFFE;
	AY_SUB_ONE_R : DFFE;
	AY_TONE12_SLOT_R : DFFE;
	AY_TONE1_SLOT_R : DFFE;
	AY_TONE1_WR_R : DFFE;
	AY_TONE1_WR_D_R : DFFE;
	AY_TONE23_SLOT_R : DFFE;
	AY_TONE2_WR_R : DFFE;
	AY_TONE3_SLOT_1_R : DFFE;
	AY_TONE3_WR_R : DFFE;
	AY_TONE3_WR_D_R : DFFE;
	AY_TONE_WR_R : DFFE;
	AY_TYPE010_R : DFFE;
	AY_VA_R[3..0] : DFFE;
	AY_VAR_R : DFFE;
	AY_VX_R : DFFE;
	BD_R[7..0] : DFFE;
	BWR_R : DFFE;

BEGIN

	BD_R[].d = D[7..0];

	BD_R[].prn = VCC;

	BD_R[].ena = AY_CCC1;

	BD_R[].clk = TG42;

	AY_VA_R[].prn = VCC;

	AY_VA_R[].clrn = AY_F_RES;

	AY_VA_R[].ena = AY_ENVELOPE_WR;

	AY_VA_R[].clk = TG42;

	AY_SH_N_R[].prn = VCC;

	AY_SH_N_R[].clrn = /RESET;

	AY_SH_N_R[].ena = AY_NOISE_ENA;

	AY_SH_N_R[].clk = TG42;

	AY_MIXER_R[].d = AY_DAT[5..0];

	AY_MIXER_R[].prn = VCC;

	AY_MIXER_R[].clrn = VCC;

	AY_MIXER_R[].ena = AY_MIXER_WR;

	AY_MIXER_R[].clk = TG42;

	AY_GF_R[].d = AY_DAT[3..0];

	AY_GF_R[].prn = VCC;

	AY_GF_R[].clrn = VCC;

	AY_GF_R[].ena = AY_FORM_WR;

	AY_GF_R[].clk = TG42;

	AY_DQX_R[].clrn = !AY_NOISE_WR;

	AY_DQX_R[].ena = AY_TONE_WR;

	AY_DQX_R[].clk = TG42;

	AY_DD_R[].d = AY_CODE[7..0];

	AY_DD_R[].prn = VCC;

	AY_DD_R[].clrn = VCC;

	AY_DD_R[].ena = AY_AX[7];

	AY_DD_R[].clk = TG42;

	AY_DAT_R[].prn = VCC;

	AY_DAT_R[].clrn = VCC;

	AY_DAT_R[].ena = AY_DAT_ENA;

	AY_DAT_R[].clk = TG42;

	AY_AMP_R[].prn = VCC;

	AY_AMP_R[].clrn = VCC;

	AY_AMP_R[].ena = VCC;

	AY_AMP_R[].clk = TG42;

	AY_ADR_R[].d = D[3..0];

	AY_ADR_R[].prn = VCC;

	AY_ADR_R[].clrn = VCC;

	AY_ADR_R[].ena = VCC;

	AY_ADR_R[].clk = AY_A_WR;

	AY_AA_R[].prn = VCC;

	AY_AA_R[].clrn = VCC;

	AY_AA_R[].ena = VCC;

	AY_AA_R[].clk = TG42;
	AY_ENVELOPE_CODE = LCELL((!AY_CODE[7] & AY_CODE[6]) & CASCADE(AY_CODE[5] & AY_CODE[2] & AY_CODE[0] & !AY_CODE[1]));
	AY_TONE_CODE_LO = LCELL((AY_CCC1 & !AY_CODE[7] & AY_CODE[1]) or (AY_CCC1 & !AY_CODE[7] & AY_CODE[0]));
	AY_MIXER_CODE_LO = LCELL(AY_CODE[5] & AY_CODE[2] & !AY_CODE[0] & AY_CODE[1]);
	AY_TONE3_CODE_LO = LCELL(AY_CODE[5] & !AY_CODE[2] & AY_CODE[0] & AY_CODE[1]);
	AY_TONE_WR_R.d = AY_TONE_CODE_LO & AY_CODE[6] & !AY_CODE[2] & AY_CODE[5];
	AY_TONE_WR_R.clk = TG42;
	AY_TONE_WR_R.clrn = VCC;
	AY_TONE_WR_R.prn = VCC;
	AY_TONE_WR_R.ena = VCC;
	AY_MIXER_WR_R.d = AY_MIXER_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_MIXER_WR_R.clk = TG42;
	AY_MIXER_WR_R.clrn = VCC;
	AY_MIXER_WR_R.prn = VCC;
	AY_MIXER_WR_R.ena = VCC;
	AY_TONE3_WR_R.d = AY_TONE3_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_TONE3_WR_R.clk = TG42;
	AY_TONE3_WR_R.clrn = VCC;
	AY_TONE3_WR_R.prn = VCC;
	AY_TONE3_WR_R.ena = VCC;
	AY_OUT1_R.d = (!AY_OUT1 & !AY_CX_N) or (AY_OUT1 & AY_CX_N);
	AY_OUT1_R.clk = TG42;
	AY_OUT1_R.clrn = VCC;
	AY_OUT1_R.prn = VCC;
	AY_OUT1_R.ena = AY_TONE1_WR;

	AY_CH12_MUX = LCELL((AY_CH1_GATE & !AY_CODE[1]) or (AY_CH2_GATE & !AY_CODE[0] & AY_CODE[1]));
	AY_CH2_GATE = LCELL((!AY_SH_N[0] & AY_MIXER[1]) or (!AY_SH_N[0] & AY_OUT2) or (AY_MIXER[4] & AY_MIXER[1]) or (AY_MIXER[4] & AY_OUT2));

	AY_CH1_GATE = LCELL((!AY_SH_N[0] & AY_MIXER[0]) or (!AY_SH_N[0] & AY_OUT1) or (AY_MIXER[3] & AY_MIXER[0]) or (AY_MIXER[3] & AY_OUT1));
	AY_DQX_R[2].d = AY_CH_MIX & AY_AMP[2];

	AY_DQX_R[2].prn = !AY_BEEPER_SAMPLE;

	AY_AMP_R[1].d = (AY_AA[1] & AY_DAT[4]) # (AY_DAT[1] & !AY_DAT[4]);

	AY_DQX_R[0].d = AY_AMP[0] & AY_CH_MIX;

	AY_DQX_R[0].prn = !AY_BEEPER_SAMPLE;

	AY_BEEPER_SAMPLE_R.d = AY_NOISE_WR & PORT_C2_CA_DATA[4];
	AY_BEEPER_SAMPLE_R.clk = TG42;
	AY_BEEPER_SAMPLE_R.clrn = VCC;
	AY_BEEPER_SAMPLE_R.prn = VCC;
	AY_BEEPER_SAMPLE_R.ena = VCC;
	AY_DQX_R[1].d = AY_AMP[1] & AY_CH_MIX;

	AY_DQX_R[1].prn = VCC;

	AY_AMP_R[0].d = (AY_AA[0] & AY_DAT[4]) # (AY_DAT[0] & !AY_DAT[4]);

	AY_AMP_R[3].d = (AY_AA[3] & AY_DAT[4]) # (AY_DAT[3] & !AY_DAT[4]);

	AY_DQX_R[3].d = AY_AMP[3] & AY_CH_MIX;

	AY_DQX_R[3].prn = !AY_BEEPER_SAMPLE;

	BD_R[1].clrn = VCC;

	AY_DI[2] = LCELL((BD[2] & !AY_CCC1 & AY_CCC0) or (AY_DAT[2] & !AY_CCC0) or (AY_DAT[2] & AY_CCC1));

	BD_R[2].clrn = VCC;

	AY_DI[1] = LCELL((BD[1] & !AY_CCC1 & AY_CCC0) or (AY_DAT[1] & !AY_CCC0) or (AY_DAT[1] & AY_CCC1));

	BD_R[3].clrn = VCC;

	AY_DI[3] = LCELL((BD[3] & !AY_CCC1 & AY_CCC0) or (AY_DAT[3] & !AY_CCC0) or (AY_DAT[3] & AY_CCC1));
	AY_FORM_CODE_LO = LCELL(AY_CODE[5] & AY_CODE[2] & AY_CODE[0] & AY_CODE[1]);
	AY_NOISE_CODE_LO = LCELL(AY_CODE[5] & AY_CODE[2] & !AY_CODE[0] & !AY_CODE[1]);
	AY_TONE2_CODE_LO = LCELL(AY_CODE[5] & !AY_CODE[2] & !AY_CODE[0] & AY_CODE[1]);
	AY_NOISE_WR_R.d = AY_NOISE_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_NOISE_WR_R.clk = TG42;
	AY_NOISE_WR_R.clrn = VCC;
	AY_NOISE_WR_R.prn = VCC;
	AY_NOISE_WR_R.ena = VCC;
	AY_TONE2_WR_R.d = AY_TONE2_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_TONE2_WR_R.clk = TG42;
	AY_TONE2_WR_R.clrn = VCC;
	AY_TONE2_WR_R.prn = VCC;
	AY_TONE2_WR_R.ena = VCC;
	AY_TONE1_WR_R.d = AY_TONE1_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_TONE1_WR_R.clk = TG42;
	AY_TONE1_WR_R.clrn = VCC;
	AY_TONE1_WR_R.prn = VCC;
	AY_TONE1_WR_R.ena = VCC;
	AY_TONE1_CODE_LO = LCELL(AY_CODE[5] & !AY_CODE[2] & AY_CODE[0] & !AY_CODE[1]);
	AY_FORM_WR_R.d = AY_FORM_CODE_LO & AY_CCC1 & !AY_CODE[7] & AY_CODE[6];
	AY_FORM_WR_R.clk = TG42;
	AY_FORM_WR_R.clrn = VCC;
	AY_FORM_WR_R.prn = VCC;
	AY_FORM_WR_R.ena = VCC;
	AY_CH_MIX_R.d = (AY_CH3_GATE & AY_CODE[0] & AY_CODE[1]) or AY_CH12_MUX;
	AY_CH_MIX_R.clk = TG42;
	AY_CH_MIX_R.clrn = VCC;
	AY_CH_MIX_R.prn = VCC;
	AY_CH_MIX_R.ena = VCC;
	AY_OUT3_R.d = (!AY_OUT3 & !AY_CX_N) or (AY_OUT3 & AY_CX_N);
	AY_OUT3_R.clk = TG42;
	AY_OUT3_R.clrn = VCC;
	AY_OUT3_R.prn = VCC;
	AY_OUT3_R.ena = AY_TONE3_WR;

	AY_CH3_GATE = LCELL((AY_MIXER[5] & AY_MIXER[2]) or (AY_MIXER[5] & AY_OUT3) or (AY_MIXER[2] & !AY_SH_N[0]) or (!AY_SH_N[0] & AY_OUT3));
	AY_TONE3_WR_D_R.d = AY_TONE3_WR;
	AY_TONE3_WR_D_R.clk = TG42;
	AY_TONE3_WR_D_R.clrn = VCC;
	AY_TONE3_WR_D_R.prn = VCC;
	AY_TONE3_WR_D_R.ena = VCC;
	AY_OUT2_R.d = (!AY_OUT2 & !AY_CX_N) or (AY_OUT2 & AY_CX_N);
	AY_OUT2_R.clk = TG42;
	AY_OUT2_R.clrn = VCC;
	AY_OUT2_R.prn = VCC;
	AY_OUT2_R.ena = AY_TONE2_WR;
	AY_TONE3_SLOT_1_R.d = AY_TONE3_WR or AY_TONE3_WR_D;
	AY_TONE3_SLOT_1_R.clk = TG42;
	AY_TONE3_SLOT_1_R.clrn = VCC;
	AY_TONE3_SLOT_1_R.prn = VCC;
	AY_TONE3_SLOT_1_R.ena = VCC;
	AY_TONE23_SLOT_R.d = AY_NOISE_TONE2_SLOT or AY_TONE3_SLOT_1 or AY_TONE3_WR or AY_TONE2_WR;
	AY_TONE23_SLOT_R.clk = TG42;
	AY_TONE23_SLOT_R.clrn = VCC;
	AY_TONE23_SLOT_R.prn = VCC;
	AY_TONE23_SLOT_R.ena = VCC;
	AY_NOISE_TONE2_SLOT_R.d = AY_NOISE_WR or AY_TONE2_WR;
	AY_NOISE_TONE2_SLOT_R.clk = TG42;
	AY_NOISE_TONE2_SLOT_R.clrn = VCC;
	AY_NOISE_TONE2_SLOT_R.prn = VCC;
	AY_NOISE_TONE2_SLOT_R.ena = VCC;
	AY_TONE1_WR_D_R.d = AY_TONE1_WR;
	AY_TONE1_WR_D_R.clk = TG42;
	AY_TONE1_WR_D_R.clrn = VCC;
	AY_TONE1_WR_D_R.prn = VCC;
	AY_TONE1_WR_D_R.ena = VCC;
	AY_TONE12_SLOT_R.d = AY_TONE1_SLOT or AY_NOISE_TONE2_SLOT or AY_TONE2_WR or AY_TONE1_WR;
	AY_TONE12_SLOT_R.clk = TG42;
	AY_TONE12_SLOT_R.clrn = VCC;
	AY_TONE12_SLOT_R.prn = VCC;
	AY_TONE12_SLOT_R.ena = VCC;
	AY_TONE1_SLOT_R.d = AY_TONE1_WR or AY_TONE1_WR_D;
	AY_TONE1_SLOT_R.clk = TG42;
	AY_TONE1_SLOT_R.clrn = VCC;
	AY_TONE1_SLOT_R.prn = VCC;
	AY_TONE1_SLOT_R.ena = VCC;
	AY_AX[5] = LCELL(AY_CCC7_N & !AY_CCC1 & !AY_CCC0);
	AY_SAMPLE_END_R.d = AY_SAMPLE_END_LO & AY_CCC7_N & AY_CCC5 & AY_CCC6;
	AY_SAMPLE_END_R.clk = TG42;
	AY_SAMPLE_END_R.clrn = VCC;
	AY_SAMPLE_END_R.prn = VCC;
	AY_SAMPLE_END_R.ena = VCC;
	AY_F_RES_R.d = AY_F_RES_D;
	AY_F_RES_R.clk = AY_CCC7_N;
	AY_F_RES_R.clrn = AY_F_R1;
	AY_F_RES_R.prn = VCC;
	AY_F_RES_R.ena = VCC;
	AY_F_RES_D_R.d = VCC;
	AY_F_RES_D_R.clk = AY_CCC7_N;
	AY_F_RES_D_R.clrn = AY_F_R1;
	AY_F_RES_D_R.prn = VCC;
	AY_F_RES_D_R.ena = VCC;
	AY_SAMPLE_START_LO = LCELL(!AY_CCC3 & !AY_CCC2 & !AY_CCC4);
	AY_CCC7_N_R.d = !CTH[1];
	AY_CCC7_N_R.clk = TG42;
	AY_CCC7_N_R.clrn = VCC;
	AY_CCC7_N_R.prn = VCC;
	AY_CCC7_N_R.ena = VCC;
	AY_SAMPLE_END_LO = LCELL(AY_CCC3 & !AY_CCC2 & !AY_CCC4);
	AY_SAMPLE_START_R.d = AY_SAMPLE_START_LO & !AY_CCC7_N & !AY_CCC5 & !AY_CCC6;
	AY_SAMPLE_START_R.clk = TG42;
	AY_SAMPLE_START_R.clrn = VCC;
	AY_SAMPLE_START_R.prn = VCC;
	AY_SAMPLE_START_R.ena = VCC;
	AY_DI[4] = LCELL((BD[4] & !AY_CCC1 & AY_CCC0) or (AY_DAT[4] & !AY_CCC0) or (AY_DAT[4] & AY_CCC1));

	AY_AX3_N = LCELL((!AY_CODE[3] or !AY_CCC1) & CASCADE((!AY_ADR[3] & AY_CCC0) or (!AY_CCC5 & !AY_CCC0) or AY_CCC1));
	AY_BD_HIGH_CLRN = LCELL(AY_ADR[3] or (AY_ADR[2] & AY_ADR[0] & AY_ADR[1]) or (!AY_ADR[2] & !AY_ADR[0]) or (!AY_ADR[0] & !AY_ADR[1]));
