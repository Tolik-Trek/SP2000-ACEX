-- Early raster and VRAM: CT/CTH/CTV/CTF, address pipeline, read clocks and write strobes. Per-bit reset/preset and enable remain explicit.
-- Named control/data banks and preserved physical helpers; independent source review pending.
INCLUDE "lpm_ram_dp";
INCLUDE "lpm_ram_dq";
SUBDESIGN video2
(
	VD2[7..0] : INPUT;
	VD3[7..0] : INPUT;
	VD1[7..0] : INPUT;
	VD0[7..0] : INPUT;
	/RD : INPUT;
	A[15..0] : INPUT;
	/RESET : INPUT;
	TG42 : INPUT;
	G_LINE[7..0] : INPUT;
	AA[15..0] : INPUT;
	PAGE[15..0] : INPUT;
	MD_OUT[15..0] : INPUT;
	XGA[7..0] : INPUT;
	GA_SEL : INPUT;
	GA_SEL_FANOUT : INPUT;
	SINC_H : INPUT;
	SINC_V : INPUT;
	CAS : INPUT;
	MC_END : INPUT;
	PORT_MD_HIGH : INPUT;
	ACC_WORD_STEP : INPUT;
	START_ACC : INPUT;
	PN[7..0] : INPUT;
	CNF[7..3] : INPUT;
	SC4 : INPUT;
	ACC_DRIVE[7..0] : INPUT;
	ACC_DRIVE_FF_D : INPUT;
	MD_HIGH_FF_D : INPUT;
	MC_WRITE_ACTIVE : INPUT;
	PORT_C5_CD_DATA[0..0] : INPUT;
	PORT_C2_CA_DATA[4..0] : INPUT;
	CT[5..0] : OUTPUT;
	CTH[5..0] : OUTPUT;
	CTV[8..0] : OUTPUT;
	STARTUP_SYNC1 : OUTPUT;
	VRAM_DATA_ENA : OUTPUT;
	KB_CLOCK_DIV_D : OUTPUT;
	V_WRITE_ENABLE[3..0] : OUTPUT;
	VA_BUFFER0 : OUTPUT;
	VA_MUX[15..0] : OUTPUT;
	VA_BUFFER1 : OUTPUT;
	VA_BUFFER10 : OUTPUT;
	VA_BUFFER2 : OUTPUT;
	VA_BUFFER3 : OUTPUT;
	VA_BUFFER11 : OUTPUT;
	VA_BUFFER4 : OUTPUT;
	VA_BUFFER9 : OUTPUT;
	VA_BUFFER5 : OUTPUT;
	VA_BUFFER8 : OUTPUT;
	VA_BUFFER13 : OUTPUT;
	VA_BUFFER12 : OUTPUT;
	VA_BUFFER14 : OUTPUT;
	VA_BUFFER15 : OUTPUT;
	V_INT_REQUEST : OUTPUT;
	VD2_WRITE[7..0] : OUTPUT;
	VD3_WRITE[7..0] : OUTPUT;
	VD1_WRITE[7..0] : OUTPUT;
	VD0_WRITE[7..0] : OUTPUT;
	SCREEN_PAGE_BANK : INPUT;
	WR_COL_DATA : OUTPUT;
)
VARIABLE
	CT[5..0] : NODE;
	CTH[5..0] : NODE;
	CTV[8..0] : NODE;
	CTF[4..0] : NODE;
	SINC_V_D : NODE;
	SINC_V_EDGE : NODE;
	SINC_H_SEEN : NODE;
	STARTUP_SYNC1 : NODE;
	STARTUP_SYNC0 : NODE;
	COPY_SINC_V : NODE;
	VADDR_COLUMN[7..0] : NODE;
	VADDR_ROW[7..0] : NODE;
	VADDR_BANK[1..0] : NODE;
	PIXEL_CODE[7..0] : NODE;
	PIXEL_PIPE[7..0] : NODE;
	PIXEL_LOAD_N[7..0] : NODE;
	PIXEL_COLOR[7..0] : NODE;
	VD3_SAMPLE1_PIPE1[7..0] : NODE;
	VCM[1..0] : NODE;
