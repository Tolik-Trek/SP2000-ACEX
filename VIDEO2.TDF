	PIXEL_LOW0_D : NODE;
	PIXEL_LOW4_D : NODE;
	PIXEL_LOW1_D : NODE;
	V_WRITE_ENABLE[3..0] : NODE;
	VA_BUFFER0 : NODE;
	VA_MUX[15..0] : NODE;
	VA_BUFFER1 : NODE;
	VA_BUFFER10 : NODE;
	VA_BUFFER2 : NODE;
	VA_BUFFER3 : NODE;
	VA_BUFFER11 : NODE;
	VA_BUFFER4 : NODE;
	VA_BUFFER9 : NODE;
	VA_BUFFER5 : NODE;
	VA_BUFFER8 : NODE;
	VA_BUFFER13 : NODE;
	VA_BUFFER12 : NODE;
	VA_BUFFER14 : NODE;
	VA_BUFFER15 : NODE;
	V_INT_REQUEST : NODE;
	CTV_CARRY5 : NODE;
	CTV_CARRY3 : NODE;
	CTV_CARRY4 : NODE;
	CTV_CARRY2 : NODE;
	CTV_WRAP : NODE;
	CTV_CARRY6 : NODE;
	CTV_CARRY8 : NODE;
	VD3_SAMPLE1[7..0] : NODE;
	VA10_DESCRIPTOR : NODE;
	VA9_DESCRIPTOR : NODE;
	VA8_DESCRIPTOR : NODE;
	VA11_DESCRIPTOR : NODE;
	VA13_DESCRIPTOR : NODE;
	VA14_DESCRIPTOR : NODE;
	VADDR_BANK_PHASE0[1..0] : NODE;
	VADDR_BANK_PHASE1[1..0] : NODE;
	VD0_SAMPLE1[7..0] : NODE;
	VD1_SAMPLE1[7..0] : NODE;
	VD1_SAMPLE2[7..0] : NODE;
	VD2_SAMPLE1[7..0] : NODE;
	VD2_SAMPLE2[7..0] : NODE;
	VD3_SAMPLE2[7..0] : NODE;
	VD2_WRITE[7..0] : NODE;
	VD3_WRITE[7..0] : NODE;
	VD1_WRITE[7..0] : NODE;
	VD0_WRITE[7..0] : NODE;
	CTF1_D_TERM1 : CARRY;
	CTF2_D_TERM1 : CARRY;
	CTF3_D_TERM1 : CARRY;
	CTF3_D_TERM2 : CARRY;
	CTV_CARRY7 : NODE;
	VRAM_ADDR_ENA_LUT_TERM1 : NODE;

	VADDR_ROW3_D_TERM1 : NODE;
	VADDR_ROW3_D_TERM2 : NODE;
	VRAM_ADDR_ENA_LUT_TERM2 : NODE;
	VRAM_ADDR_ENA_LUT_TERM3 : NODE;
	VRAM_DATA_ENA_D_D_TERM1 : NODE;
	VRAM_ADDR_ENA_LUT_TERM4 : NODE;
	VRAM_ADDR_ENA_LUT_TERM5 : NODE;

	VA9_DESCRIPTOR_D_TERM1 : NODE;
	VA8_DESCRIPTOR_D_TERM1 : NODE;
	VA8_DESCRIPTOR_D_TERM2 : NODE;
	CTH_CARRY2 : NODE;

	VD0_SAMPLE13_CLK_TERM1 : NODE;
	VA9_DESCRIPTOR_D_TERM2 : NODE;
	VA11_DESCRIPTOR_D_TERM1 : NODE;
	VA8_DESCRIPTOR_D_TERM3 : NODE;
	WR_COL_D_TERM1 : NODE;
	WR_COL_D_TERM2 : NODE;
	WR_COL_DATA : NODE;
	WR_COL_D_TERM4 : NODE;
	VA13_DESCRIPTOR_D_TERM1 : NODE;
	VA13_DESCRIPTOR_D_TERM2 : NODE;
	VA13_DESCRIPTOR_D_TERM3 : NODE;
	VA14_DESCRIPTOR_D_TERM1 : NODE;
	VA14_DESCRIPTOR_D_TERM2 : NODE;
	VA14_DESCRIPTOR_D_TERM3 : NODE;
	VD1_SAMPLE23_CLK_TERM1 : NODE;
	CTV7_ENA_TERM1 : NODE;
	LINE_ADVANCE_D_D_TERM1 : NODE;
	LINE_ADVANCE_D_D_TERM2 : NODE;
	VD3_SAMPLE24_CLK_TERM1 : NODE;
	VD2_SAMPLE21_CLK_TERM1 : NODE;
	VRAM_SAMPLE_CLK0_D_D_TERM1 : NODE;
	CTH1_ENA_TERM1 : NODE;
	CT5_D_TERM1 : NODE;
	CTH_WRAP : NODE;
	CTH_CARRY3 : NODE;
	CTH_CARRY4 : NODE;
	CTH_CARRY5 : NODE;
	VA10_DESCRIPTOR_D_TERM1 : NODE;
	VA10_DESCRIPTOR_D_TERM2 : NODE;
	VA10_DESCRIPTOR_D_TERM3 : NODE;
	VA9_DESCRIPTOR_D_TERM3 : NODE;
	WR_COL_D_TERM5 : NODE;
	-- Explicit instances preserve FF source names across module ports.
	COPY_SINC_H_R : DFFE;
	COPY_SINC_V_R : DFFE;
	CT_R[5..0] : DFFE;
	CTF_R[4..0] : DFFE;
	CTH_R[5..0] : DFFE;
	CTV_R[8..0] : DFFE;
	CT_3F_D_R : DFFE;
	CT_HI_ZERO_D_R : DFFE;
	CT_MID_ZERO_D_R : DFFE;
	KB_CLOCK_DIV_D_R : DFFE;
	LINE_ADVANCE_D_R : DFFE;
	PIXEL_CODE_R[7..0] : DFFE;
	PIXEL_COLOR_R[7..0] : DFFE;
	PIXEL_HIGH1_D_R : DFFE;
	PIXEL_HIGH2_D_R : DFFE;
	PIXEL_HIGH3_D_R : DFFE;
	PIXEL_HIGH7_D_R : DFFE;
	PIXEL_LOW0_D_R : DFFE;
	PIXEL_LOW1_D_R : DFFE;
	PIXEL_LOW2_D_R : DFFE;
	PIXEL_LOW4_D_R : DFFE;
	PIXEL_PIPE_R[7..0] : DFFE;
	SINC_H_D_R : DFFE;
	SINC_H_EDGE_R : DFFE;
	SINC_H_SEEN_R : DFFE;
	SINC_V_D_R : DFFE;
	SINC_V_EDGE_R : DFFE;
	STARTUP_SYNC0_R : DFFE;
	STARTUP_SYNC1_R : DFFE;
	VA10_DESCRIPTOR_R : DFFE;
	VA11_DESCRIPTOR_R : DFFE;
	VA13_DESCRIPTOR_R : DFFE;
	VA14_DESCRIPTOR_R : DFFE;
	VA8_DESCRIPTOR_R : DFFE;
	VA9_DESCRIPTOR_R : DFFE;
	VADDR_BANK_R[1..0] : DFFE;
	VADDR_BANK_PHASE0_R[1..0] : DFFE;
	VADDR_BANK_PHASE1_R[1..0] : DFFE;
	VADDR_COLUMN_R[7..0] : DFFE;
	VADDR_ROW_R[7..0] : DFFE;
	VCM_R[1..0] : DFFE;
	VD0_SAMPLE1_R[7..0] : DFFE;
	VD0_WRITE_R[7..0] : DFFE;
	VD1_SAMPLE1_R[7..0] : DFFE;
	VD1_SAMPLE2_R[7..0] : DFFE;
	VD1_WRITE_R[7..0] : DFFE;
	VD2_SAMPLE1_R[7..0] : DFFE;
	VD2_SAMPLE2_R[7..0] : DFFE;
	VD2_WRITE_R[7..0] : DFFE;
	VD3_SAMPLE1_R[7..0] : DFFE;
	VD3_SAMPLE1_PIPE1_R[7..0] : DFFE;
	VD3_SAMPLE2_R[7..0] : DFFE;
	VD3_WRITE_R[7..0] : DFFE;
	VIDEO_CMD0_N_D_R : DFFE;
	VIDEO_CMD_DECODE6_R : DFFE;
	VIDEO_CMD_F_R : DFFE;
	VIDEO_CMD_F_SYNC_R : DFFE;
	VIDEO_CMD_PACKED_R : DFFE;
	VIDEO_FIELD2_R : DFFE;
	VIDEO_FIELD3_R : DFFE;
	VRAM_DATA_ENA_D_R : DFFE;
	VRAM_SAMPLE_CLK0_D_R : DFFE;
	VRAM_SAMPLE_CLK1_R : DFFE;
	VRAM_SAMPLE_CLK1_D_R : DFFE;
	VRAM_SAMPLE_CLK2_R : DFFE;
	VRAM_SAMPLE_CLK2_D_R : DFFE;
	V_INT_REQUEST_R : DFFE;
	V_PHASE_CAPTURE_R : DFFE;
	V_WORD_ACCESS_D_R : DFFE;
	V_WRITE_ACTIVE_R : DFFE;
	V_WRITE_GATE_D_R : DFFE;
	V_WRITE_RELEASE_D_R : DFFE;

	-- Positive counter values; Q aliases above retain native encoded phase bits.
	CTH_COUNT[5..0], CTH_NEXT[5..0] : NODE;
	CTV_COUNT[8..0], CTV_NEXT[8..0] : NODE;
	FRAME_COUNT[4..0], FRAME_NEXT[4..0] : NODE;
	CT_UP_NEXT[2..0] : NODE;

	CTH_TOGGLE[5..0], CTV_TOGGLE[8..0] : NODE;

BEGIN

    -- Shared physical carry/decoder prefixes of the bank contracts below.
    -- All equations are parallel; LCELL/CASCADE/CARRY topology is retained.
    CTV_CARRY5 = LCELL(CTV_CARRY2 & CTV_COUNT[4] & CTV_COUNT[2] & CTV_COUNT[3]);
    CTV_CARRY3 = LCELL(CTV_COUNT[2..0]==7);
    CTV_CARRY4 = LCELL(CTV_COUNT[3..0]==15);
    CTV_CARRY2 = LCELL(CTV_COUNT[1..0]==3);
    CTV_WRAP = LCELL((CTV_COUNT[8..7]==2) & CASCADE((CTV_COUNT[6..4]==3) & CTV_CARRY4));
    CTV_CARRY6 = LCELL(CTV_COUNT[5] & CTV_COUNT[4] & CTV_COUNT[3] & CTV_CARRY3);
    CTV_CARRY7 = LCELL(CTV_CARRY6 & CTV_COUNT[6]);
    CTV_CARRY8 = LCELL(CTV_COUNT[7] & CTV_CARRY6 & CTV_COUNT[6]);
    CTH_CARRY2 = LCELL(CTH_COUNT[1..0]==3);
    CTH_WRAP = LCELL((CTH_COUNT[5..4]==3) & CASCADE(CTH_COUNT[3..0]==7));
    CTH_CARRY3 = LCELL(CTH_COUNT[2..0]==7);
    CTH_CARRY4 = LCELL(CTH_COUNT[3..0]==15);
    CTH_CARRY5 = LCELL(CTH_COUNT[4] & CTH_COUNT[3] & CTH_CARRY3);

    -- VRAM address capture, TG42 rising; all18 FF retain VRAM_ADDR_ENA.
    -- GRAF=1: accelerator address is split into row/bank, XGA into column.
    -- GRAF=0: AA supplies column/bank; G_LINE/XGA supplies row.
    -- The XGA column permutation is physical VRAM lane order, not arithmetic.
    CASE GA_SEL_FANOUT IS
      WHEN 0 =>
        VADDR_COLUMN_R[].d = (AA[7],AA[6],AA[5],AA[4],AA[3],AA[2],AA[1],AA[0]);
        VADDR_ROW_R[].d = (G_LINE[4],G_LINE[3],G_LINE[2],G_LINE[1],VADDR_ROW3_D_TERM2,XGA[5],XGA[6],XGA[4]);
        VADDR_BANK_R[].d = (AA[9],AA[8]);
      WHEN 1 =>
        VADDR_COLUMN_R[].d = (XGA[3],XGA[2],XGA[1],XGA[0],XGA[7],XGA[5],XGA[6],XGA[4]);
        VADDR_ROW_R[].d = (AA[9],AA[8],AA[7],AA[6],AA[5],AA[4],AA[3],AA[2]);
        VADDR_BANK_R[].d = (AA[1],AA[0]);
    END CASE;

    -- Positive count 0..55; actual storage is count xor2E. COPY_SINC_H
    -- asynchronously clears that storage, hence reloads positive count46.
    CTH_COUNT[] = CTH[] xor H"2E";
    CTH_TOGGLE[] = (CTH_CARRY5,CTH_CARRY4,CTH_CARRY3,CTH_CARRY2,CTH_COUNT[0],VCC);
    CTH_NEXT[] = CTH[] xor CTH_TOGGLE[];
    CTH_R[2..0].d = CTH_NEXT[2..0];
    -- At55, free increment gives56; only the upper three bits need wrap.
    IF CTH_WRAP THEN CTH_R[5..3].d = B"101";
    ELSE CTH_R[5..3].d = CTH_NEXT[5..3]; END IF;

    -- Positive count 0..319; storage=count xor118. COPY_SINC_V clears
    -- encoded storage to0, hence reloads positive count280.
    CTV_COUNT[] = CTV[] xor H"118";
    CTV_TOGGLE[] = (CTV_CARRY8,CTV_CARRY7,CTV_CARRY6,CTV_CARRY5,CTV_CARRY4,CTV_CARRY3,CTV_CARRY2,CTV_COUNT[0],VCC);
    CTV_NEXT[] = CTV[] xor CTV_TOGGLE[];
    CTV_R[5..0].d = CTV_NEXT[5..0]; CTV_R[7].d = CTV_NEXT[7];
    -- At319, free increment320 differs from0 only in positive bits8/6.
    IF CTV_WRAP THEN (CTV_R[8].d,CTV_R[6].d) = (VCC,GND);
    ELSE (CTV_R[8].d,CTV_R[6].d) = (CTV_NEXT[8],CTV_NEXT[6]); END IF;
    -- Low two phase bits form modulo3. CT2 retains its actual CT1 enable
    -- and inverted D connection. The upper word adds CT2 on that same enable.
    CASE CT[1..0] IS
      WHEN 0 => CT_R[1..0].d = 1;
      WHEN 1 => CT_R[1..0].d = 2;
      WHEN 2,3 => CT_R[1..0].d = 0;
    END CASE;
    CT_UP_NEXT[] = (CT[5],CT[3],CT[4]) + (GND,GND,CT[2]);
    (CT_R[5].d,CT_R[3].d,CT_R[4].d) = CT_UP_NEXT[];

    -- Frame counter rises on !encoded CTV8, i.e. positive CTV_COUNT[8].
    -- Native physical lane order is preserved on both sides of the sum.
    FRAME_COUNT[] = (CTF[3],CTF[2],CTF[1],CTF[4],CTF[0]);
    FRAME_NEXT[] = FRAME_COUNT[] + 1;
    (CTF_R[3].d,CTF_R[2].d,CTF_R[1].d,CTF_R[4].d,CTF_R[0].d) = FRAME_NEXT[];

	VD3_WRITE_R[].d = ACC_DRIVE[7..0];

	VD3_WRITE_R[].prn = VCC;

	VD3_WRITE_R[].clrn = VCC;

	VD3_WRITE_R[].ena = VRAM_ADDR_ENA;

	VD3_WRITE_R[].clk = TG42;

	VD3_SAMPLE2_R[].d = VD3[7..0];

	VD3_SAMPLE2_R[].prn = VCC;

	VD3_SAMPLE2_R[].clrn = VCC;

	VD3_SAMPLE2_R[].ena = VCC;

	VD3_SAMPLE2_R[].clk = VD3_SAMPLE24_CLK_TERM1;

	VD3_SAMPLE1_PIPE1_R[].d = VD3_SAMPLE1[7..0];

	VD3_SAMPLE1_PIPE1_R[].prn = VCC;

	VD3_SAMPLE1_PIPE1_R[].clrn = VCC;

	VD3_SAMPLE1_PIPE1_R[].ena = VCC;

	VD3_SAMPLE1_R[].d = VD3[7..0];

	VD3_SAMPLE1_R[].prn = VCC;

	VD3_SAMPLE1_R[].clrn = VCC;

	VD3_SAMPLE1_R[].ena = VCC;

	VD3_SAMPLE1_R[].clk = VRAM_SAMPLE_CLK0;

	VD2_WRITE_R[].prn = VCC;

	VD2_WRITE_R[].clrn = VCC;

	VD2_WRITE_R[].ena = VRAM_ADDR_ENA;

	VD2_WRITE_R[].clk = TG42;

	VD2_SAMPLE2_R[].d = VD2[7..0];

	VD2_SAMPLE2_R[].prn = VCC;

	VD2_SAMPLE2_R[].clrn = VCC;

	VD2_SAMPLE2_R[].ena = VCC;

	VD2_SAMPLE2_R[].clk = VD2_SAMPLE21_CLK_TERM1;

	VD2_SAMPLE1_R[].d = VD2[7..0];

	VD2_SAMPLE1_R[].prn = VCC;

	VD2_SAMPLE1_R[].clrn = VCC;

	VD2_SAMPLE1_R[].ena = VCC;

	VD2_SAMPLE1_R[].clk = VRAM_SAMPLE_CLK0;

	VD1_WRITE_R[].d = ACC_DRIVE[7..0];

	VD1_WRITE_R[].prn = VCC;

	VD1_WRITE_R[].clrn = VCC;

	VD1_WRITE_R[].ena = VRAM_ADDR_ENA;

	VD1_WRITE_R[].clk = TG42;

	VD1_SAMPLE2_R[].d = VD1[7..0];

	VD1_SAMPLE2_R[].prn = VCC;

	VD1_SAMPLE2_R[].clrn = VCC;

	VD1_SAMPLE2_R[].ena = VCC;

	VD1_SAMPLE2_R[].clk = VD1_SAMPLE23_CLK_TERM1;

	VD1_SAMPLE1_R[].d = VD1[7..0];

	VD1_SAMPLE1_R[].prn = VCC;

	VD1_SAMPLE1_R[].clrn = VCC;

	VD1_SAMPLE1_R[].ena = VCC;

	VD1_SAMPLE1_R[].clk = VRAM_SAMPLE_CLK0;

	VD0_WRITE_R[].prn = VCC;

	VD0_WRITE_R[].clrn = VCC;

	VD0_WRITE_R[].ena = VRAM_ADDR_ENA;

	VD0_WRITE_R[].clk = TG42;

	VD0_SAMPLE1_R[].d = VD0[7..0];

	VD0_SAMPLE1_R[].prn = VCC;

	VD0_SAMPLE1_R[].clrn = VCC;

	VD0_SAMPLE1_R[].ena = VCC;

	VD0_SAMPLE1_R[].clk = VD0_SAMPLE13_CLK_TERM1;

	VCM_R[].prn = VCC;

	VCM_R[].clrn = VCC;

	VCM_R[].ena = VCC;

	VCM_R[].clk = TG42;

	VADDR_ROW_R[].prn = VCC;

	VADDR_ROW_R[].clrn = VCC;

	VADDR_ROW_R[].ena = VRAM_ADDR_ENA;

	VADDR_ROW_R[].clk = TG42;

	VADDR_COLUMN_R[].prn = VCC;

	VADDR_COLUMN_R[].clrn = VCC;

	VADDR_COLUMN_R[].ena = VRAM_ADDR_ENA;

	VADDR_COLUMN_R[].clk = TG42;

	VADDR_BANK_PHASE1_R[].d = VADDR_BANK_PHASE0[1..0];

	VADDR_BANK_PHASE1_R[].prn = VCC;

	VADDR_BANK_PHASE1_R[].clrn = VCC;

	VADDR_BANK_PHASE1_R[].ena = VCC;

	VADDR_BANK_PHASE1_R[].clk = TG42;

	VADDR_BANK_PHASE0_R[].prn = VCC;

	VADDR_BANK_PHASE0_R[].clrn = VCC;

	VADDR_BANK_PHASE0_R[].ena = VCC;

	VADDR_BANK_PHASE0_R[].clk = TG42;

	VADDR_BANK_R[].prn = VCC;

	VADDR_BANK_R[].clrn = VCC;

	VADDR_BANK_R[].ena = VRAM_ADDR_ENA;

	VADDR_BANK_R[].clk = TG42;

	PIXEL_PIPE_R[].prn = VCC;

	PIXEL_PIPE_R[].clrn = VCC;

