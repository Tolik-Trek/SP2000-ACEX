
	TITLE "Video-controller";

INCLUDE "lpm_ram_dp";

PARAMETERS
	(
	MODE = "SPRINTER",
	MOUSE = "NO",
	HOR_PLACE = H"50",
	VER_PLACE = H"91"
	);

SUBDESIGN video2
	(
	CLK42		: INPUT;

	CT[5..0]	: OUTPUT;
	CTH[5..0]	: OUTPUT;
	CTV[8..0]	: OUTPUT;
	CTF[6..0]	: OUTPUT;

	BLANK		: OUTPUT;

	START_UP	: INPUT;
	XA2P		: INPUT;
	XA3P		: INPUT;

	WR			: INPUT;

	VW_STB		: INPUT;
	VA_EN		: INPUT;
	VDWCK		: INPUT;
	ACC_RAM_SOURCE		: INPUT;
	ACC_MD_COPY		: INPUT;
	IOX			: INPUT;
	ACCQ[7..0]	: INPUT;
	MDP[15..8]	: INPUT;

	GRFX		: INPUT;
	PHB			: INPUT;
	PHC			: INPUT;
	ACC_CYCLE_N		: INPUT;
	SCREEN_ROW6_XOR		: INPUT;

	IVSTB		: INPUT;
	IVD3[7..2]	: OUTPUT;
	IVD30		: OUTPUT;

	PHA			: INPUT;
	IP2			: INPUT;
	ID4			: INPUT;
	IPAT		: INPUT;
	IC1			: INPUT;

	VAI[19..0]	: INPUT;

	VAO[15..0]	: OUTPUT;

	D[7..0]		: INPUT;
	MDI[15..0]	: INPUT;

	VDO0[7..0]	: OUTPUT;
	VDO1[7..0]	: OUTPUT;
	VDO2[7..0]	: OUTPUT;
	VDO3[7..0]	: OUTPUT;

	VDM0[7..0]	: INPUT;
	VDM1[7..0]	: INPUT;
	VDM2[7..0]	: INPUT;
	VDM3[7..0]	: INPUT;

	V_WR[3..0]	: OUTPUT;
	V_WEN[3..0]	: OUTPUT;

	V_CS[1..0]	: OUTPUT;
	WR_PIX		: OUTPUT;

	ZX_PORT[7..0]	: INPUT;
	DIR_PORT[7..0]	: INPUT;

	INTT		: OUTPUT;
	H_RESYNC		: OUTPUT;
	V_RESYNC		: OUTPUT;
	COLOR_ALL_ONES		: OUTPUT;

	DOUBLE_CAS	: INPUT;

	MOUSE_X[9..0]	: INPUT;
	MOUSE_Y[9..0]	: INPUT;

	MA_PHASE[1..0] : INPUT;
	XA_READ_PHASE : INPUT;
	XA_HALF_CYCLE : INPUT;
	VRAM_CAPTURE_A[7..0] : INPUT;
	VRAM_CAPTURE_B[7..0] : INPUT;

	BORDER_BITS[2..0] : INPUT;
)
VARIABLE
    CLK84 : NODE;

    CLK84_X : NODE;

    CLK84_Y : NODE;

    ZX_COLOR[3..0] : NODE;

    MA_PHASE_H_R : NODE;

    MA_PHASE_L_R : NODE;

    XA_READ_PHASE_R : NODE;

    XA_HALF_CYCLE_R : NODE;

    BUS_STARTUP_RELEASE_R : NODE;

    CTF[6..0] : NODE;

    VDQ0[7..0] : DFFE;

    VDQ1[7..0] : DFFE;

    VDQ2[7..0] : DFFE;

    VDQ3[7..0] : DFFE;

    BLANK : NODE;

    BORD : NODE;

    INTTX : NODE;

    VCM[2..0] : DFF;

    TSN_W3 : DFF;

    D_PIC0[7..0] : DFFE;

    D_PIC0_[7..0] : DFFE;

    D_PIC1_[7..0] : DFFE;

    D_PIC2_[7..0] : DFFE;

    D_PIC3_[7..0] : DFFE;

    D_PICX_[7..0] : NODE;

    DPX[7..0] : NODE;

    DPY[7..0] : NODE;

    DPIC_SEL[1..0] : DFF;

    LWR_PIC : NODE;

    LWR_COL : NODE;

    WR_PIC : DFF;

    WR_COL : DFF;

    LD_PIC : NODE;

    RBRVA[10..8] : DFF;

    BRVA[7..0] : DFF;

    DCOL[7..0] : DFFE;

    AX128 : NODE;

    BRD[2..0] : NODE;

    ZX_COL[3..0] : LCELL;

    MODE0[7..0] : DFFE;

    MODE1[7..0] : DFFE;

    MODE2[7..0] : DFFE;

    WR_MODE : DFF;

    LWR_MODE : NODE;

    X_MODE[7..4] : NODE;

    X_MODE_BOND : NODE;

    PIC_CLK : NODE;

    CT_R[5..0], CTH_R[5..0], CTV_R[8..0], FRAME_R[4..0] : DFFE;

    CTH_COUNT[5..0], CTH_NEXT[5..0] : NODE;

    CTV_COUNT[8..0], CTV_NEXT[8..0] : NODE;

    CT_HIGH_NEXT[2..0] : NODE;

    VAH[17..0] : DFFE;

    DESC1_R[7..0] : DFFE;

    DESC2_R[7..0] : DFFE;

    DESC3_R[7..0] : DFFE;

    PIX0_R[7..0] : DFFE;

    PIX1_R[7..0] : DFFE;

    PIX2_R[7..0] : DFFE;

    PIX3_R[7..0] : DFFE;

    PIXEL_SHIFT_R[7..0] : DFFE;

    COLOR_R[7..0] : DFFE;

    PIXEL_HEAD_N[7..0], PIXEL_TAIL_N[7..0], PIXEL_MUX_N[7..0] : NODE;

    PIXEL_SELECT_R[1..0] : DFFE;

    PIXEL_SELECT_STAGE_R[1..0] : DFFE;

    PIXEL_SELECT_DESC_R[1..0] : DFFE;

    VA_MEMORY[15..0], VA_RASTER[15..0], VA_DESC[15..0], VA_PIXEL[15..0],
    VA_HEAD_N[15..0], VA_TAIL_N[15..0], VA_SELECT_N[15..0], VA_BUFFER_N[15..0] : NODE;

    VD_WRITE_ALL_BYTES_R, VD_WRITE_RELEASE_R, VD_WRITE_PENDING_R, VD_WRITE_ACTIVE_R,
    VD_WRITE_ENABLE0, VD_WRITE_ENABLE1, VD_WRITE_ENABLE2, VD_WRITE_ENABLE3,
    PIXEL_PHASE_WIDE_R, PIXEL_PHASE_NARROW_R, PIXEL_LOAD, COLOR_UPDATE_EN,
    PIXEL_FREEZE_R, PIXEL_SHIFT_EN, DESC_WIDTH_R, DESC_V3_R,
    DESC_V2_R, DESC_GRAPHICS_R, DESC_TEXT_R, DESC_FLASH_R,
    DESC_COLOR_MASK_R, DESC_BIT1_R, VA_DESC0_R, VA_PIXEL0_R,
    VA_DESC1_R, VA_PIXEL1_R, VA_DESC10_R, VA_PIXEL10_R,
    VA_DESC2_R, VA_TEXT_N_R, VA_DESC9_R, VA_PIXEL9_R,
    VA_DESC8_R, VA_PIXEL8_R, VA_DESC13_R, VA_PIXEL13_R,
    VA_DESC12_R, VA_PIXEL12_R, VA_DESC14_R, VA_PIXEL14_R,
    VA_DESC15_R, VA_PIXEL15_R, VA_DESC11_R, VA_PIXEL11_R,
    VA_SCR128_R, DESC_BIT0_R, VA_FLASH_BIT, VA_LINE2_SELECT,
    VA_LINE2_TEXT, VA_LINE1_SELECT, VA_LINE0_SELECT, VA_LINE1_TEXT,
    VA_LINE0_TEXT, VA_PHASE_SELECT, PIXEL_SELECT_TEXT0, PIXEL_SELECT_TEXT1,
    PIXEL_SELECT_RASTER0, PIXEL_SELECT_RASTER1, COLOR_LOW_ONES, COLOR_HIGH_ONES,
    VA_OUTPUT7, VA_OUTPUT6, VA_OUTPUT5_BASE, VA_OUTPUT5,
    VA_OUTPUT4_BASE, VA_OUTPUT4, VA_OUTPUT3_BASE, VA_OUTPUT3,
    BORDER_GREEN, BORDER_RED, BORDER_BLUE, VIDEO_BANK,
    H_RESYNC, V_RESYNC, COLOR_ALL_ONES, H_SYNC_SAMPLE_R,
    H_SYNC_DELAY_R, H_SYNC_EDGE_R, V_SYNC_SAMPLE_R, V_SYNC_DELAY_R,
    V_SYNC_EDGE_R, H_COUNTER_SAMPLE_R, V_COUNT_PHASE_R, H_COUNT_PHASE_R,
    H_WRAP_N, H_TICK_PHASE_A, H_TICK_PHASE_B, V_TICK_PHASE,
    V_COUNT_ENABLE, H_COUNT_ENABLE, V_COUNTER_TERMINAL, V_WRAP_N,
    V_COUNTER_TERMINAL_N, RASTER_PHASE_XOR, ADDRESS_PHASE_RESET : NODE;

BEGIN
DEFAULTS
		WR_MODE.d	= VCC;
		TSN_W3.d	= VCC;
		WR_COL.d	= VCC; WR_PIC.d		= VCC;
	END DEFAULTS;

-- Author raster/descriptor/pixel/write banks. Physical LCELL/CASCADE cuts are retained only at functional word boundaries.
-- OLD VIDEO2:VXA write-address capture. TG42 rising, VA_EN; early routing differs from later donor.
VAH[].clk = CLK42;
VAH[].ena = VA_EN;
IF GRFX THEN
    VAH[] = (VAI2,VAI10,VAI0,VAI1,VAI8,VAI9,VAI7,VAI17,VAI16,VAI6,VAI15,VAI5,VAI12,VAI4,VAI14,VAI13,VAI3,VAI11);
ELSE
    VAH[] = (VAI10,VAI0,VAI8,VAI9,ZX_PORT3,ZX_PORT4,ZX_PORT2,VAI7,VAI6,ZX_PORT1,VAI5,SCREEN_ROW6_XOR,VAI2,VAI12,VAI4,VAI3,VAI11,VAI1);
END IF;
-- VDM descriptor byte captured on IVSTB rising; no async reset/enable.
DESC1_R[].clk = IVSTB;
DESC1_R[].ena = VCC;
DESC1_R[] = VDM1[];
-- VDM descriptor byte captured on IVSTB rising; no async reset/enable.
DESC2_R[].clk = IVSTB;
DESC2_R[].ena = VCC;
DESC2_R[] = VDM2[];
-- VDM descriptor byte captured on IVSTB rising; no async reset/enable.
DESC3_R[].clk = IVSTB;
DESC3_R[].ena = VCC;
DESC3_R[] = VDM3[];
-- Independent pixel byte sampled at TG42 falling; distinct from descriptor IVSTB domain.
PIX0_R[].clk = !CLK42;
PIX0_R[].ena = VCC;
PIX0_R[] = VDM0[];
-- Independent pixel byte sampled at TG42 falling; distinct from descriptor IVSTB domain.
PIX1_R[].clk = !CLK42;
PIX1_R[].ena = VCC;
PIX1_R[] = VDM1[];
-- Independent pixel byte sampled at TG42 falling; distinct from descriptor IVSTB domain.
PIX2_R[].clk = !CLK42;
PIX2_R[].ena = VCC;
PIX2_R[] = VDM2[];
-- Independent pixel byte sampled at TG42 falling; distinct from descriptor IVSTB domain.
PIX3_R[].clk = !CLK42;
PIX3_R[].ena = VCC;
PIX3_R[] = VDM3[];
-- Eight-bit parallel-load/left-shift word, TG42 rising, freeze while descriptor comparator active.
PIXEL_SHIFT_R[].clk = CLK42;
PIXEL_SHIFT_R[].ena = PIXEL_SHIFT_EN;
IF PIXEL_LOAD THEN PIXEL_SHIFT_R[] = !PIXEL_MUX_N[];
ELSE PIXEL_SHIFT_R[] = (PIXEL_SHIFT_R[6..0],GND); END IF;
-- Color/pixel latch: async !IPAT clear; IP2-low update; border pattern is actual captured border register.
COLOR_R[].clk = CLK42;
COLOR_R[].clrn = !IPAT;
COLOR_R[].ena = COLOR_UPDATE_EN;
IF ID4 THEN COLOR_R[] = (GND,GND,BORDER_BITS2,BORDER_BITS1,BORDER_BITS0,BORDER_BITS2,BORDER_BITS1,BORDER_BITS0);
ELSE COLOR_R[] = !PIXEL_MUX_N[]; END IF;
-- Four-byte pixel selector: {SEL1,SEL0}=00/01/10/11 selects PIX0/1/2/3.
-- The negative two-level CASCADE mux is an original physical boundary.
PIXEL_HEAD_N[] = (!PIX3_R[] & PIXEL_SELECT_R0) or (!PIX2_R[] & !PIXEL_SELECT_R0) or !PIXEL_SELECT_R1;
PIXEL_TAIL_N[] = PIXEL_SELECT_R1 or (!PIX1_R[] & PIXEL_SELECT_R0) or (!PIX0_R[] & !PIXEL_SELECT_R0);
FOR bit IN 0 TO 7 GENERATE
    PIXEL_MUX_N[bit] = LCELL(PIXEL_HEAD_N[bit] & CASCADE(PIXEL_TAIL_N[bit]));
END GENERATE;
-- Two-stage pixel-bank selection, TG42 rising.
PIXEL_SELECT_R[].clk = CLK42;
PIXEL_SELECT_R[].ena = VCC;
PIXEL_SELECT_R[] = PIXEL_SELECT_STAGE_R[];
-- PIXEL_SELECT_STAGE_R
PIXEL_SELECT_STAGE_R[].clk = CLK42;
PIXEL_SELECT_STAGE_R[].ena = VCC;
PIXEL_SELECT_STAGE_R[] = (PIXEL_SELECT_DESC_R[] & !PHC) or ((VAH[14],VAH[15]) & !PHB) or (!PHB & !PHC);
-- Descriptor/raster pixel-bank selector; two physical LUT stages retained.
PIXEL_SELECT_DESC_R[].clk = CLK42;
PIXEL_SELECT_DESC_R[].ena = VCC;
PIXEL_SELECT_DESC_R[] = ((PIXEL_SELECT_RASTER1 & !DESC3_R[4]) or PIXEL_SELECT_TEXT1, (PIXEL_SELECT_RASTER0 & !DESC3_R[4]) or PIXEL_SELECT_TEXT0);
-- The four address-source words use the same VA output bit positions.
-- Bits3..7 follow the separate positive-polarity SOP output boundary below;
-- their unused negative-CASCADE source lanes are tied low, with no state.
    VA_MEMORY[] = (VAH[10], VAH[9], VAH[7], VAH[3], VAH[2], VAH[5], VAH[0], VAH[16], GND, GND, GND, GND, GND, VAH[4], VAH[1], VAH[17]);
    VA_RASTER[] = (DIR_PORT3, CTH5, CTH4, CTH3, CTH2, CTH1, CTH0, CT5, GND, GND, GND, GND, GND, CTV5, CTV4, CTV3);
    VA_DESC[] = (VA_DESC15_R, VA_DESC14_R, VA_DESC13_R, VA_DESC12_R, VA_DESC11_R, VA_DESC10_R, VA_DESC9_R, VA_DESC8_R, GND, GND, GND, GND, GND, VA_DESC2_R, VA_DESC1_R, VA_DESC0_R);
    VA_PIXEL[] = (VA_PIXEL15_R, VA_PIXEL14_R, VA_PIXEL13_R, VA_PIXEL12_R, VA_PIXEL11_R, VA_PIXEL10_R, VA_PIXEL9_R, VA_PIXEL8_R, GND, GND, GND, GND, GND, !VA_TEXT_N_R, VA_PIXEL1_R, VA_PIXEL0_R);

-- VA phase contract: PHC:PHB=00 pixel,01 descriptor,10 memory,
-- 11 raster. Eleven slices use the original negative CASCADE+buffer pair.
VA_HEAD_N[] = (!VA_MEMORY[] & !PHB) or !PHC or (!VA_RASTER[] & PHB);
VA_TAIL_N[] = PHC or (!VA_DESC[] & PHB) or (!VA_PIXEL[] & !PHB);
VA_SELECT_N[0] = LCELL(VA_HEAD_N[0] & CASCADE(VA_TAIL_N[0]));
VA_BUFFER_N[0] = LCELL(VA_SELECT_N[0]);
VA_SELECT_N[1] = LCELL(VA_HEAD_N[1] & CASCADE(VA_TAIL_N[1]));
VA_BUFFER_N[1] = LCELL(VA_SELECT_N[1]);
VA_SELECT_N[2] = LCELL(VA_HEAD_N[2] & CASCADE(VA_TAIL_N[2]));
VA_BUFFER_N[2] = LCELL(VA_SELECT_N[2]);
VA_SELECT_N[8] = LCELL(VA_HEAD_N[8] & CASCADE(VA_TAIL_N[8]));
VA_BUFFER_N[8] = LCELL(VA_SELECT_N[8]);
VA_SELECT_N[9] = LCELL(VA_HEAD_N[9] & CASCADE(VA_TAIL_N[9]));
VA_BUFFER_N[9] = LCELL(VA_SELECT_N[9]);
VA_SELECT_N[10] = LCELL(VA_HEAD_N[10] & CASCADE(VA_TAIL_N[10]));
VA_BUFFER_N[10] = LCELL(VA_SELECT_N[10]);
VA_SELECT_N[11] = LCELL(VA_HEAD_N[11] & CASCADE(VA_TAIL_N[11]));
VA_BUFFER_N[11] = LCELL(VA_SELECT_N[11]);
VA_SELECT_N[12] = LCELL(VA_HEAD_N[12] & CASCADE(VA_TAIL_N[12]));
VA_BUFFER_N[12] = LCELL(VA_SELECT_N[12]);
VA_SELECT_N[13] = LCELL(VA_HEAD_N[13] & CASCADE(VA_TAIL_N[13]));
VA_BUFFER_N[13] = LCELL(VA_SELECT_N[13]);
VA_SELECT_N[14] = LCELL(VA_HEAD_N[14] & CASCADE(VA_TAIL_N[14]));
VA_BUFFER_N[14] = LCELL(VA_SELECT_N[14]);
VA_SELECT_N[15] = LCELL(VA_HEAD_N[15] & CASCADE(VA_TAIL_N[15]));
VA_BUFFER_N[15] = LCELL(VA_SELECT_N[15]);

    CT_R[].clk = CLK42; CT_R[].clrn = VCC; CT_R[].prn = VCC;
    CT_R[1..0].ena = VCC; CT_R[5..2].ena = CT1;
    CASE CT[1..0] IS
      WHEN 0 => CT_R[1..0].d = 1;
      WHEN 1 => CT_R[1..0].d = 2;
      WHEN 2,3 => CT_R[1..0].d = 0;
    END CASE;
    CT_R[2].d = !CT2;
    CT_HIGH_NEXT[] = CT[5..3] + (GND,GND,CT2);
    CT_R[5..3].d = CT_HIGH_NEXT[];

    CTH_R[].clk = CLK42; CTH_R[].ena = H_COUNT_ENABLE;
    CTH_R[].clrn = !H_RESYNC; CTH_R[].prn = VCC;
    CTH_COUNT[] = CTH_R[].q xor H"2E";
    IF !H_WRAP_N THEN CTH_NEXT[] = 0;
    ELSE CTH_NEXT[] = CTH_COUNT[] + 1; END IF;
    CTH_R[].d = CTH_NEXT[] xor H"2E";

    CTV_R[].clk = CLK42; CTV_R[].ena = V_COUNT_ENABLE;
    CTV_R[].clrn = !V_RESYNC; CTV_R[].prn = VCC;
    CTV_COUNT[] = CTV_R[].q xor H"118";
    IF !V_WRAP_N THEN CTV_NEXT[] = 0;
    ELSE CTV_NEXT[] = CTV_COUNT[] + 1; END IF;
    CTV_R[].d = CTV_NEXT[] xor H"118";

    FRAME_R[].clk = CTV_COUNT8; FRAME_R[].ena = VCC;
    FRAME_R[].clrn = VCC; FRAME_R[].prn = VCC;
    FRAME_R[].d = FRAME_R[].q + 1;
    CTF[] = (GND,GND,FRAME_R[].q);

	ZX_COLOR[] = ZX_COL[];

	H_COUNT_PHASE_R	= DFFE(CT_R[5] & CT_R[3] & CT_R[2] & CT_R[4], CLK42,,,);
	H_COUNT_ENABLE	= LCELL(CT_R[1] & H_COUNT_PHASE_R);
	V_TICK_PHASE	= LCELL(CT_R[3] & CT_R[4] & !CTH_R[0] & CT_R[5]);
	H_TICK_PHASE_B	= LCELL(!CTH_R[5] & CTH_R[4] & CTH_R[2] & CTH_R[3]);
	V_COUNT_PHASE_R	= DFFE(V_TICK_PHASE & H_TICK_PHASE_B & CTH_R[1] & CT_R[2], CLK42,,,);
	V_COUNT_ENABLE	= LCELL(CT_R[1] & V_COUNT_PHASE_R);

	H_TICK_PHASE_A	= LCELL(!CTH_R[3] or !CTH_R[0] or CTH_R[2]);
	H_WRAP_N	= LCELL(CTH_R[5] or !CTH_R[4] or CTH_R[1] or H_TICK_PHASE_A);

	H_COUNTER_SAMPLE_R	= DFFE(!CTH_R[5], CLK42,,,);

	V_COUNTER_TERMINAL	= LCELL(!CTV_R[5] or !CTV_R[2] or !CTV_R[0] or !CTV_R[1]);
	V_COUNTER_TERMINAL_N	= LCELL(CTV_R[7] or CTV_R[6] or CTV_R[8] or V_COUNTER_TERMINAL);
	V_WRAP_N	= LCELL(V_COUNTER_TERMINAL_N or CTV_R[3] or CTV_R[4]);

	RASTER_PHASE_XOR	= LCELL((!CT_R[2] & CT_R[0]) or (CT_R[2] & !CT_R[0]));
	ADDRESS_PHASE_RESET	= LCELL(CT_R[2] & !CT_R[1]);

	MA_PHASE_L_R = MA_PHASE[0];

	MA_PHASE_H_R = MA_PHASE[1];
	BUS_STARTUP_RELEASE_R	= DFFE(VCC, CLK42,,, CT_R[0]);

	XA_READ_PHASE_R = XA_READ_PHASE;

	XA_HALF_CYCLE_R = XA_HALF_CYCLE;

	H_SYNC_SAMPLE_R	= DFFE(XA2P, !XA_READ_PHASE_R, BUS_STARTUP_RELEASE_R, VCC, XA_HALF_CYCLE_R);
	H_SYNC_DELAY_R	= DFFE(H_SYNC_SAMPLE_R, CLK42,,,);
	H_SYNC_EDGE_R	= DFFE(!H_SYNC_SAMPLE_R & H_SYNC_DELAY_R, CLK42,,,);
	H_RESYNC	= DFFE(H_SYNC_EDGE_R, CLK42,,,);

	V_SYNC_SAMPLE_R	= DFFE(XA3P, !XA_READ_PHASE_R, BUS_STARTUP_RELEASE_R, VCC, XA_HALF_CYCLE_R);
	V_SYNC_DELAY_R	= DFFE(V_SYNC_SAMPLE_R, CLK42,,,);
	V_SYNC_EDGE_R	= DFFE(V_SYNC_DELAY_R & !V_SYNC_SAMPLE_R, CLK42,,,);
	V_RESYNC	= DFFE(V_SYNC_EDGE_R, CLK42,,,);

	CT[5..0]	= (CT_R[5], CT_R[4], CT_R[3], CT_R[2], CT_R[1], CT_R[0]);
	CTH[5..0]	= (!CTH_R[5], CTH_R[4], !CTH_R[3], !CTH_R[2], !CTH_R[1], CTH_R[0]);
	CTV[8..0]	= (CTV_R[8], CTV_R[7], CTV_R[6], CTV_R[5], !CTV_R[4], !CTV_R[3], CTV_R[2], CTV_R[1], CTV_R[0]);

	WR_PIX	= (TSN_W3);

	VDQ0[].clk = CLK42;	VDQ0[].ena = VA_EN;
	VDQ0[] = VRAM_CAPTURE_B[];
	VDQ1[].clk = CLK42;	VDQ1[].ena = VA_EN;
	VDQ1[] = VRAM_CAPTURE_A[];
	VDQ2[].clk = CLK42;	VDQ2[].ena = VA_EN;
	VDQ2[] = VRAM_CAPTURE_B[];
	VDQ3[].clk = CLK42;	VDQ3[].ena = VA_EN;
	VDQ3[] = VRAM_CAPTURE_A[];
	VDO0[]	= VDQ0[];
	VDO1[]	= VDQ1[];
	VDO2[]	= VDQ2[];
	VDO3[]	= VDQ3[];

	VD_WRITE_ALL_BYTES_R	= DFFE(ACC_MD_COPY & !ACC_CYCLE_N,CLK42,,,VA_EN);

	VD_WRITE_RELEASE_R	= DFFE(VCC,!CLK42,VD_WRITE_ACTIVE_R,,);
	VD_WRITE_PENDING_R	= DFFE(VA_EN or VD_WRITE_PENDING_R,CLK42,!VD_WRITE_ACTIVE_R,,);
	VD_WRITE_ACTIVE_R	= DFFE(VD_WRITE_PENDING_R & !PHB & PHC,CLK42,!VD_WRITE_RELEASE_R,,);
	VD_WRITE_ENABLE0	= LCELL((VD_WRITE_ACTIVE_R & VAH[14] & VAH[15]) or (VD_WRITE_ACTIVE_R & VAH[14] & VD_WRITE_ALL_BYTES_R));
	VD_WRITE_ENABLE1	= LCELL((VAH[14] & VD_WRITE_ACTIVE_R & !VAH[15]) or (VAH[14] & VD_WRITE_ACTIVE_R & VD_WRITE_ALL_BYTES_R));
	VD_WRITE_ENABLE2	= LCELL((!VAH[14] & VD_WRITE_ACTIVE_R & VAH[15]) or (!VAH[14] & VD_WRITE_ACTIVE_R & VD_WRITE_ALL_BYTES_R));
	VD_WRITE_ENABLE3	= LCELL((!VAH[14] & VD_WRITE_ACTIVE_R & !VAH[15]) or (!VAH[14] & VD_WRITE_ACTIVE_R & VD_WRITE_ALL_BYTES_R));
	V_WEN[]	= (VD_WRITE_ENABLE3,VD_WRITE_ENABLE2,VD_WRITE_ENABLE1,VD_WRITE_ENABLE0);
	V_WR[]	= (!VD_WRITE_ENABLE3,!VD_WRITE_ENABLE2,!VD_WRITE_ENABLE1,!VD_WRITE_ENABLE0);

	IVD3[]	= (DESC3_R[7],DESC3_R[6],DESC3_R[5],DESC3_R[4],DESC3_R[3],DESC3_R[2]);
	IVD30	= DESC3_R[0];

	PIXEL_PHASE_WIDE_R	= DFFE(!CT5 & !CT4 & !CT3,CLK42,,,);
	PIXEL_PHASE_NARROW_R	= DFFE(!CT3 & !CT2 & !CT4,CLK42,,,);
	PIXEL_LOAD	= LCELL((!DESC3_R[5] & PIXEL_PHASE_NARROW_R) or (DESC3_R[5] & PIXEL_PHASE_WIDE_R));

	DESC_BIT1_R	= DFFE(DESC3_R[1],CLK42,,,);
	DESC_WIDTH_R	= DFFE(DESC3_R[6],IP2,,,);
	DESC_V3_R	= DFFE(DESC3_R[3],CLK42,,,);
	DESC_V2_R	= DFFE(DESC3_R[2],CLK42,,,);
	DESC_GRAPHICS_R	= DFFE(DESC3_R[4] or DESC3_R[5],IP2,,,);
	DESC_TEXT_R	= DFFE(DESC3_R[4],IP2,,,);
	DESC_FLASH_R	= DFFE(DESC3_R[7],IP2,,,);
	DESC_COLOR_MASK_R	= DFFE(!DESC3_R[4] & DESC3_R[7] & DESC3_R[5],IP2,,,);

	VA_DESC0_R	= DFFE((!PHA & CTV2 & DESC3_R[4]) or (VA_PHASE_SELECT & !DESC3_R[4]),CLK42,,,);
	VA_PIXEL0_R	= DFFE((PIXEL_SHIFT_R[7] & DESC_TEXT_R) or (DESC_WIDTH_R & !DESC_TEXT_R),CLK42,!ID4,,);
	VA_DESC1_R	= DFFE((DESC3_R[4] & DESC3_R[6]) or (!DESC3_R[4] & DESC2_R[0]) or (DESC3_R[4] & PHA),CLK42,,,);
	VA_PIXEL1_R	= DFFE((VA_FLASH_BIT & DESC_TEXT_R) or (DESC_FLASH_R & !DESC_TEXT_R),CLK42,!ID4,,);
	VA_DESC10_R	= DFFE((VA_LINE2_SELECT & !DESC3_R[4]) or VA_LINE2_TEXT,CLK42,,,);
	VA_PIXEL10_R	= DFFE((!DESC_GRAPHICS_R & CT2 & COLOR_R[6]) or (DESC_GRAPHICS_R & COLOR_R[2]) or (!CT2 & COLOR_R[2]),CLK42,,,);
	VA_DESC2_R	= DFFE((DESC3_R[4] & DESC3_R[7]) or (!DESC3_R[4] & DESC2_R[1]) or (DESC3_R[4] & PHA),CLK42,,,);
	VA_TEXT_N_R	= DFFE(!DESC_TEXT_R,CLK42,!ID4,,);
	VA_DESC9_R	= DFFE((!DESC3_R[4] & VA_LINE1_SELECT) or VA_LINE1_TEXT,CLK42,,,);
	VA_PIXEL9_R	= DFFE((!DESC_GRAPHICS_R & CT2 & COLOR_R[5]) or (DESC_GRAPHICS_R & COLOR_R[1]) or (!CT2 & COLOR_R[1]),CLK42,,,);
	VA_DESC8_R	= DFFE((!DESC3_R[4] & VA_LINE0_SELECT) or VA_LINE0_TEXT,CLK42,,,);
	VA_PIXEL8_R	= DFFE((!DESC_GRAPHICS_R & CT2 & COLOR_R[4]) or (COLOR_R[0] & DESC_GRAPHICS_R) or (COLOR_R[0] & !CT2),CLK42,,,);
	VA_DESC13_R	= DFFE((DESC1_R[5] & PHA & DESC3_R[4]) or (DESC2_R[5] & !DESC3_R[4]) or (DESC2_R[5] & !PHA),CLK42,,,);
	VA_PIXEL13_R	= DFFE(COLOR_R[5] & DESC_GRAPHICS_R,CLK42,,,);
	VA_DESC12_R	= DFFE((DESC1_R[4] & PHA & DESC3_R[4]) or (DESC2_R[4] & !DESC3_R[4]) or (DESC2_R[4] & !PHA),CLK42,,,);
	VA_PIXEL12_R	= DFFE(COLOR_R[4] & DESC_GRAPHICS_R,CLK42,,,);
	VA_DESC14_R	= DFFE((DESC1_R[6] & PHA & DESC3_R[4]) or (DESC2_R[6] & !DESC3_R[4]) or (DESC2_R[6] & !PHA),CLK42,,,);
	VA_PIXEL14_R	= DFFE(COLOR_R[6] & DESC_GRAPHICS_R,CLK42,,,);
	VA_DESC15_R	= DFFE((DESC1_R[7] & PHA & DESC3_R[4]) or (DESC2_R[7] & !DESC3_R[4]) or (DESC2_R[7] & !PHA),CLK42,,,);
	VA_PIXEL15_R	= DFFE(COLOR_R[7] & DESC_GRAPHICS_R,CLK42,,,);
	VA_DESC11_R	= DFFE((DESC2_R[3] & !DESC3_R[4]) or (DESC2_R[3] & !PHA) or (DESC1_R[3] & PHA & DESC3_R[4]),CLK42,,,);

	VA_FLASH_BIT	= LCELL(CTF4 & !IPAT);
	VA_LINE2_SELECT	= LCELL((DESC1_R[2] & DESC1_R[1]) or (!DESC1_R[2] & CTV2));
	VA_LINE2_TEXT	= LCELL((DESC1_R[2] & DESC3_R[4] & PHA) or (DESC3_R[4] & !PHA & DESC2_R[2]));
	VA_LINE1_SELECT	= LCELL((DESC1_R[2] & CTV2) or (!DESC1_R[2] & CTV1));
	VA_LINE0_SELECT	= LCELL((DESC1_R[2] & CTV1) or (!DESC1_R[2] & CTV0));
	VA_LINE1_TEXT	= LCELL((DESC3_R[4] & DESC1_R[1] & PHA) or (DESC3_R[4] & !PHA & DESC2_R[1]));
	VA_LINE0_TEXT	= LCELL((DESC1_R[0] & DESC3_R[4] & PHA) or (DESC3_R[4] & !PHA & DESC2_R[0]));
	VA_PHASE_SELECT	= LCELL((DESC1_R[2] & DESC1_R[0]) or (!DESC1_R[2] & CT5));

	PIXEL_FREEZE_R	= DFFE(IC1,CLK42,,,);
	PIXEL_SHIFT_EN	= LCELL(!PIXEL_FREEZE_R);

	PIXEL_SELECT_TEXT0	= LCELL((!DESC3_R[6] & DESC3_R[4] & PHA) or (DESC3_R[4] & !CTV0 & !PHA));
	PIXEL_SELECT_TEXT1	= LCELL((!DESC3_R[7] & DESC3_R[4] & PHA) or (DESC3_R[4] & !CTV1 & !PHA));
	PIXEL_SELECT_RASTER0	= LCELL((DESC1_R[2] & !CT4) or (!DESC1_R[2] & !CT3));
	PIXEL_SELECT_RASTER1	= LCELL((DESC1_R[2] & !CT5) or (!DESC1_R[2] & !CT4));
	COLOR_UPDATE_EN	= LCELL(!IP2);

	BORDER_GREEN = BORDER_BITS[1];
	BORDER_RED = BORDER_BITS[2];
	BORDER_BLUE = BORDER_BITS[0];
	VIDEO_BANK	= DIR_PORT3;

	COLOR_LOW_ONES	= LCELL(COLOR_R[0] & COLOR_R[1] & COLOR_R[2] & COLOR_R[3]);
	COLOR_HIGH_ONES	= LCELL(COLOR_R[4] & COLOR_R[5] & COLOR_R[6] & COLOR_R[7]);
	COLOR_ALL_ONES	= LCELL(DESC_COLOR_MASK_R & COLOR_HIGH_ONES & COLOR_LOW_ONES);

	VA_PIXEL11_R	= DFFE((!DESC_GRAPHICS_R & CT2 & COLOR_R[7]) or (COLOR_R[3] & DESC_GRAPHICS_R) or (COLOR_R[3] & !CT2),CLK42,,,);
	VA_SCR128_R	= DFFE((DIR_PORT0 & DESC3_R[4]) or (DESC2_R[2] & !DESC3_R[4]),CLK42,,,);
	DESC_BIT0_R	= DFFE(DESC3_R[0],CLK42,,,);

	VA_OUTPUT7	= LCELL((DESC_V3_R & !PHC) or (VAH[12] & !PHB) or (!PHB & !PHC) or (PHB & PHC));
	VA_OUTPUT6	= LCELL((DESC_V2_R & !PHC) or (VAH[13] & !PHB) or (!PHB & !PHC) or (PHB & PHC));
	VA_OUTPUT5_BASE	= LCELL((DESC_BIT1_R & !PHC) or (VAH[11] & !PHB) or (!PHB & !PHC));
	VA_OUTPUT5	= LCELL(VA_OUTPUT5_BASE or (PHB & !CTV8 & PHC));
	VA_OUTPUT4_BASE	= LCELL((DESC_BIT0_R & !PHC) or (VAH[8] & !PHB) or (!PHB & !PHC));
	VA_OUTPUT4	= LCELL((CTV7 & PHC & PHB) or VA_OUTPUT4_BASE);
	VA_OUTPUT3_BASE	= LCELL((VA_SCR128_R & !PHC) or (VAH[6] & !PHB) or (!PHB & !PHC));
	VA_OUTPUT3	= LCELL(VA_OUTPUT3_BASE or (CTV6 & PHC & PHB));

	BRD[]		= DIR_PORT[7..5];

	VCM[].clk	= CLK42;
	TSN_W3.clk	= CLK42;

IF MODE == "SPRINTER" GENERATE

	BORD	= DFF((MODE0[7..4] == 15),LWR_COL,,);
	BLANK	= DFF(((BORD & DESC3_R[3] & DESC3_R[2]) or DIR_PORT4),LWR_COL,,);
	INTTX 	= DFF((BORD & DESC3_R[3] & DESC3_R[2] & DESC3_R[0]),LWR_COL,,);

	INTT	= DFF(!(INTTX & (CTV[2..0] == 7)),CT5,,);

	CASE CT[2..0] IS
		WHEN B"110" => VCM[2..0].d = 5;
		WHEN B"000" => VCM[2..0].d = 1;
		WHEN B"001" => VCM[2..0].d = 4;
		WHEN B"010" => VCM[2..0].d = 3;
		WHEN B"100" => VCM[2..0].d = 2;
		WHEN B"101" => VCM[2..0].d = 0;
	END CASE;

	CASE VCM[1..0] IS
		WHEN 0 =>
			IF VCM2 THEN
				TSN_W3.d  = X_MODE_BOND;
			ELSE
				TSN_W3.d  = X_MODE_BOND;
			END IF;
		WHEN 1 =>
			WR_PIC.d	= !VCM2;
			WR_COL.d	= VCM2;
		WHEN 3 =>
			WR_PIC.d	= X_MODE5;
			WR_MODE.d	= !(CT[5..3] == B"111") & !(CT4 & CT3 & !MODE0[5]);
	END CASE;

	V_CS1	= VCC;

	V_CS0	= GND;

	X_MODE_BOND	= GND;

	LD_PIC	= LCELL((MODE0[5] & DFF((CT[5..3] == B"000"),CLK42,,)) or (!MODE0[5] & DFF((CT[4..2] == B"000"),CLK42,,)));

	PIC_CLK			= !CLK42;

	D_PIC0_[].clk	= PIC_CLK;
	D_PIC1_[].clk	= PIC_CLK;
	D_PIC2_[].clk	= PIC_CLK;
	D_PIC3_[].clk	= PIC_CLK;

	D_PIC0_[] = VDM0[];
	D_PIC1_[] = VDM1[];
	D_PIC2_[] = VDM2[];
	D_PIC3_[] = VDM3[];

	DPIC_SEL[].clk	= CLK42;
	DPIC_SEL[1].d	= VA_BUFFER_N[1];
	DPIC_SEL[0].d	= VA_BUFFER_N[0];

	CASE DPIC_SEL[] IS
		WHEN 0 => DPX[] = !D_PIC0_[];
		WHEN 1 => DPX[] = !D_PIC1_[];
		WHEN 2 => DPX[] = VCC;
		WHEN 3 => DPX[] = VCC;
	END CASE;
	CASE DPIC_SEL[] IS
		WHEN 0 => DPY[] = VCC;
		WHEN 1 => DPY[] = VCC;
		WHEN 2 => DPY[] = !D_PIC2_[];
		WHEN 3 => DPY[] = !D_PIC3_[];
	END CASE;

	FOR i IN 0 TO 7 GENERATE
		D_PICX_[i] = !(DPX[i] & DPY[i]);
	END GENERATE;

	MODE0[].ena 	= VCC;
	MODE1[].ena 	= VCC;
	MODE2[].ena 	= VCC;
	MODE0[].clk		= LWR_MODE;
	MODE1[].clk		= LWR_MODE;
	MODE2[].clk		= LWR_MODE;
	MODE0[].d		= VDM3[];
	MODE1[].d		= VDM2[];
	MODE2[].d		= VDM1[];
	LWR_MODE		= LCELL(LCELL(WR_MODE));

	X_MODE7	= DFF(MODE0[7],LWR_COL,,);
	X_MODE6	= DFF(MODE0[6],LWR_COL,,);
	X_MODE5	= DFF(MODE0[5],LWR_COL,,);
	X_MODE4 = DFF(MODE0[4],LWR_COL,,);

	VAO[0]		= DFF(!VA_BUFFER_N[0],CLK42,,);
	VAO[1]		= DFF(!VA_BUFFER_N[1],CLK42,,);
	VAO[2]		= DFF(!VA_BUFFER_N[2],CLK42,,);
	VAO[3]		= DFF(VA_OUTPUT3,CLK42,,);
	VAO[4]		= DFF(VA_OUTPUT4,CLK42,,);
	VAO[5]		= DFF(VA_OUTPUT5,CLK42,,);
	VAO[6]		= DFF(VA_OUTPUT6,CLK42,,);
	VAO[7]		= DFF(VA_OUTPUT7,CLK42,,);
	VAO[8]		= DFF(!VA_BUFFER_N[8],CLK42,,);
	VAO[9]		= DFF(!VA_BUFFER_N[9],CLK42,,);
	VAO[10]		= DFF(!VA_BUFFER_N[10],CLK42,,);
	VAO[11]		= DFF(!VA_BUFFER_N[11],CLK42,,);
	VAO[12]		= DFF(!VA_BUFFER_N[12],CLK42,,);
	VAO[13]		= DFF(!VA_BUFFER_N[13],CLK42,,);
	VAO[14]		= DFF(!VA_BUFFER_N[14],CLK42,,);
	VAO[15]		= DFF(!VA_BUFFER_N[15],CLK42,,);

	WR_PIC.clk		= CLK42;
	WR_COL.clk		= CLK42;
	WR_MODE.clk		= CLK42;

	LWR_PIC		= DFF(WR_PIC,CLK42,,);
	LWR_COL		= DFF(WR_COL,CLK42,,);

	D_PIC0[].ena	= !LWR_PIC;
	D_PIC0[].clk	= CLK42;

	IF LD_PIC THEN

		D_PIC0[] = D_PICX_[];
	ELSE
		D_PIC0[] = (D_PIC0[6..0],GND);
	END IF;

	DCOL[].ena	= !LWR_COL;
	DCOL[].clk	= CLK42;

	IF DFF((MODE0[7..4] == 15),WR_PIC,,) THEN
		DCOL[].d	= (B"00",BRD[2..0],BRD[2..0]);
	ELSE

		DCOL[].d	= D_PICX_[];
	END IF;

	DCOL[].clrn	= !BLANK;

	BRVA[].clk	= CLK42;

	CASE (DFF((MODE0[4] or MODE0[5]),LWR_COL,,),CT2) IS
		WHEN B"1X" => BRVA[7..0] = DCOL[];
		WHEN B"01" => BRVA[7..0] = (B"0000",DCOL[7..4]);
		WHEN B"00" => BRVA[7..0] = (B"0000",DCOL[3..0]);
	END CASE;

	RBRVA[].clk = CLK42;

	CASE (BORD,X_MODE4) IS
		WHEN B"X0" => RBRVA[10..8].d = (GND,X_MODE[7..6]);
		WHEN B"X1" => RBRVA[10..8].d = (VCC,(CTF4 & !BLANK),D_PIC0[7]);
	END CASE;

	RBRVA[9..8].clrn = !BORD;
	RBRVA[10].prn = !BORD;

	CASE (RBRVA[9..8],BRVA7) IS
		WHEN 0,1,4,7 => ZX_COL[] = (BRVA[6],BRVA[5..3]);
		WHEN 2,3,6,5 => ZX_COL[] = (BRVA[6],BRVA[2..0]);
	END CASE;

	CLK84	= LCELL(CLK42 xor CLK84_X);
	CLK84_X	= DFF(!CLK84_X,CLK84,,);
	CLK84_Y	= CLK84;

END GENERATE;

END;
