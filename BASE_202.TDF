	WR_COL_DATA : NODE;


BEGIN
	DECODE.MD_HIGH_FF_D = MD_HIGH_FF_D;
	DECODE.ACC_DRIVE_FF_D = ACC_DRIVE_FF_D;


	-- Early raster and VRAM: CT/CTH/CTV/CTF, address pipeline, read clocks and write strobes. Per-bit reset/preset and enable remain explicit.
	SVIDEO./RD = /RD;
	SVIDEO./RESET = /RESET;
	SVIDEO.AA[] = AA[];
	SVIDEO.ACC_DRIVE[] = ACC_DRIVE[];
	SVIDEO.ACC_DRIVE_FF_D = ACC_DRIVE_FF_D;
