	-- Early keyboard: serial receiver state, prefix/modifier flags and key translation RAM. Original RAM bit ordering is explicit.
	KEYS./IO = /IO;
	KEYS./RF = /RF;
	KEYS.ALL_MODE0_N = ALL_MODE0_N;
	KEYS.A[] = A[];
	KEYS.KBD_CC = KBD_CC;
