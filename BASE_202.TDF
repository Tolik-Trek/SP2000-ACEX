	KB_PRESSED[] = KEYS.KB_PRESSED[];
	KB_RESET_REQUEST = KEYS.KB_RESET_REQUEST;
	KB_SHIFT = KEYS.KB_SHIFT;
	-- Early AY engine: data/address ports, register microcode RAM and tone/noise/envelope state. RAM contents are taken from this ACX reverse.
