-- Restored early BASE_202: six live hardware blocks and package interfaces.
-- Functional bank contracts retain necessary physical LCELL and fanout structure.
INCLUDE "video2";
INCLUDE "dcp";
INCLUDE "acceler";
INCLUDE "kbd";
INCLUDE "ay";
INCLUDE "audio";
SUBDESIGN BASE_202
(
	/RD : INPUT;
	/WR : INPUT;
	/IO : INPUT;
	A[15..0] : INPUT;
	/RF : INPUT;
	/M1 : INPUT;
	XA3 : INPUT;
	/MR : INPUT;
	TG42 : INPUT;
	/HALT : INPUT;
	VA[15..0] : OUTPUT;
	V_CS[1..0] : OUTPUT;
	V_WR[3..0] : OUTPUT;
	RA[17..14] : OUTPUT;
	CS_CASH : OUTPUT;
	CS_ROM : OUTPUT;
	CLKZ1 : OUTPUT;
	/WE : OUTPUT;
	CAS_[3..0] : OUTPUT;
	WR_DWG : OUTPUT;
	RD_KMPS : OUTPUT;
	SXA : OUTPUT;
	RAS_[1..0] : OUTPUT;
	MA[14..0] : OUTPUT;
	WR_AWG : OUTPUT;
	RDXA : OUTPUT;
	XACS : OUTPUT;
	DAC_BCK : OUTPUT;
	DAC_WS : OUTPUT;
	DAC_DATA : OUTPUT;
	WR_COL : OUTPUT;
	VD2[7..0] : BIDIR;
	VD3[7..0] : BIDIR;
	VD1[7..0] : BIDIR;
	VD0[7..0] : BIDIR;
	D[7..0] : BIDIR;
	/RESET : BIDIR;
	/WAIT : BIDIR;
	XA[2..0] : BIDIR;
	MD[15..0] : BIDIR;
)
VARIABLE
	SVIDEO : video2;
	DECODE : dcp;
	ACC : acceler;
	KEYS : kbd;
	AY3 : ay;
	SOUND : audio;
	CT[5..0] : NODE;
	CTH[5..0] : NODE;
	CTV[8..0] : NODE;
	G_LINE[7..0] : NODE;
	AA[15..0] : NODE;
