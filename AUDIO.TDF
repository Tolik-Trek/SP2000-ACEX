-- Early stereo AY sample, Covox mix and twelve-bit serial DAC.
-- Every register has its original clock/enable; encoded carry bit remains
-- complemented so arbitrary native INIT bits match the original circuit.
SUBDESIGN audio
(
    CLK42 : INPUT;
    CT[5..0] : INPUT;
    CTH[1..0] : INPUT;
    SAMPLE_SLOT : INPUT;
    BIT_CLOCK_DELAY : INPUT;
    AY_LEFT[10..1], AY_RIGHT[10..1] : INPUT;
    CBL_RAW[10..0] : INPUT;
    DAC_DATA, DAC_BCK, DAC_WS : OUTPUT;
)
VARIABLE
    AY_CH_LS[10..1], AY_CH_RS[10..1], AY_AMX[10..1] : DFFE;

    MIX_SAMPLE_R[11..0], SERIAL_R[11..0] : DFFE;

    LOAD_SLOT_R, DAC_LAUNCH_R, DAC_DATA_R, DAC_BCK_R,
    DAC_WS_R : DFFE;

    CBQ[10..0], CARRY_N[11..1], MIX_HALF[10..1] : NODE;

    SC2, SC3, SC5, SC7,
    SC9, SG5, SG7, SG9,
    SH5, SH7, SH9 : NODE;

BEGIN
    -- Actual AY accumulator output has already been scaled by /2.
    -- Capture both channels on the real AY sample-slot edge.
    (AY_CH_LS[].clk,AY_CH_RS[].clk) = SAMPLE_SLOT;
    (AY_CH_LS[].ena,AY_CH_RS[].ena) = VCC;
    (AY_CH_LS[].clrn,AY_CH_RS[].clrn) = VCC;
    (AY_CH_LS[].prn,AY_CH_RS[].prn) = VCC;
    AY_CH_LS[].d = AY_LEFT[]; AY_CH_RS[].d = AY_RIGHT[];
    AY_AMX[].clk = CLK42; AY_AMX[].ena = VCC;
    AY_AMX[].clrn = VCC; AY_AMX[].prn = VCC;
    CASE CTH1 IS
      WHEN 0 => AY_AMX[].d = AY_CH_RS[].q;
      WHEN 1 => AY_AMX[].d = AY_CH_LS[].q;
    END CASE;

    -- Raw EAB output lanes, in the logical eleven-bit unsigned mix word.
    -- Low three lines remain arbitrary actual RAM bits, not assumed zero.
    CBQ[] = (CBL_RAW2,CBL_RAW6,CBL_RAW3,CBL_RAW9,CBL_RAW5,
             CBL_RAW7,CBL_RAW0,CBL_RAW8,CBL_RAW4,CBL_RAW10,CBL_RAW1);

    -- Physical negative carry-prefix LUTs and the three explicit odd-bit
    -- half-sum LUTs. They feed the bank equation below and preserve fanout.
    SC2 = LCELL((!AY_AMX2 & !AY_AMX1) or (!AY_AMX2 & !CBQ2) or (!AY_AMX2 & !CBQ1) or (!AY_AMX1 & !CBQ2) or (!CBQ1 & !CBQ2));
    SC3 = LCELL((!AY_AMX3 & !CBQ3) or (!AY_AMX3 & SC2) or (!CBQ3 & SC2));
    SG5 = LCELL(!CBQ5 & !AY_AMX5);
    SH5 = LCELL(CBQ5 $ AY_AMX5);
    SC5 = LCELL(((!AY_AMX4 & !CBQ4) or (!AY_AMX4 & SC3) or (!CBQ4 & SC3) or SG5)
						& CASCADE(!CBQ5 or !AY_AMX5));
    SG7 = LCELL(!CBQ7 & !AY_AMX7);
    SH7 = LCELL(CBQ7 $ AY_AMX7);
    SC7 = LCELL(((!AY_AMX6 & !CBQ6) or (!AY_AMX6 & SC5) or (!CBQ6 & SC5) or SG7)
						& CASCADE(!CBQ7 or !AY_AMX7));
    SG9 = LCELL(!CBQ9 & !AY_AMX9);
    SH9 = LCELL(CBQ9 $ AY_AMX9);
    SC9 = LCELL(((!AY_AMX8 & !CBQ8) or (!AY_AMX8 & SC7) or (!CBQ8 & SC7) or SG9)
						& CASCADE(!CBQ9 or !AY_AMX9));

    CARRY_N1 = VCC;
    CARRY_N2 = !(AY_AMX1 & CBQ1);
    CARRY_N3 = SC2; CARRY_N4 = SC3;
    CARRY_N5 = (!AY_AMX4 & !CBQ4) or (!AY_AMX4 & SC3) or (!CBQ4 & SC3);
    CARRY_N6 = SC5;
    CARRY_N7 = (!AY_AMX6 & !CBQ6) or (!AY_AMX6 & SC5) or (!CBQ6 & SC5);
    CARRY_N8 = SC7;
    CARRY_N9 = (!AY_AMX8 & !CBQ8) or (!AY_AMX8 & SC7) or (!CBQ8 & SC7);
    CARRY_N10 = SC9;
    CARRY_N11 = (!AY_AMX10 & !CBQ10) or (!AY_AMX10 & SC9) or (!CBQ10 & SC9);
    MIX_HALF[4..1] = AY_AMX[4..1] xor CBQ[4..1];
    MIX_HALF5 = SH5; MIX_HALF6 = AY_AMX6 xor CBQ6;
    MIX_HALF7 = SH7; MIX_HALF8 = AY_AMX8 xor CBQ8;
    MIX_HALF9 = SH9; MIX_HALF10 = AY_AMX10 xor CBQ10;

    -- Registered sum=(AY_AMX<<1)+CBQ, sampled on falling CTH0.
    -- Bit11 stores negative carry: its complementary physical encoding is
    -- required for exact INIT0 and is intentionally retained at the DAC MSB.
    MIX_SAMPLE_R[].clk = !CTH0; MIX_SAMPLE_R[].ena = VCC;
    MIX_SAMPLE_R[].clrn = VCC; MIX_SAMPLE_R[].prn = VCC;
    MIX_SAMPLE_R[0].d = CBQ0;
    MIX_SAMPLE_R[10..1].d = MIX_HALF[] xor !CARRY_N[10..1];
    MIX_SAMPLE_R[11].d = CARRY_N11;

    -- DAC pad BCK and AY internal delayed BCK are distinct physical states.
    DAC_BCK_R.clk = CLK42; DAC_BCK_R.d = CT2;
    DAC_WS_R.clk = CLK42; DAC_WS_R.d = CTH1;
    (DAC_BCK_R.ena,DAC_WS_R.ena) = VCC;
    (DAC_BCK_R.clrn,DAC_WS_R.clrn) = VCC;
    (DAC_BCK_R.prn,DAC_WS_R.prn) = VCC;
    LOAD_SLOT_R.clk = CT2; LOAD_SLOT_R.d = CTH0 & CT5 & CT4 & CT3;
    LOAD_SLOT_R.ena = VCC; LOAD_SLOT_R.clrn = VCC; LOAD_SLOT_R.prn = VCC;
    SERIAL_R[].clk = CLK42; SERIAL_R[].ena = !CT2 & BIT_CLOCK_DELAY;
    SERIAL_R[].clrn = VCC; SERIAL_R[].prn = VCC;
    CASE LOAD_SLOT_R.q IS
      WHEN 1 => SERIAL_R[].d = (MIX_SAMPLE_R0.q,MIX_SAMPLE_R1.q,
                 MIX_SAMPLE_R2.q,MIX_SAMPLE_R3.q,MIX_SAMPLE_R4.q,MIX_SAMPLE_R5.q,
                 MIX_SAMPLE_R6.q,MIX_SAMPLE_R7.q,MIX_SAMPLE_R8.q,MIX_SAMPLE_R9.q,
                 MIX_SAMPLE_R10.q,MIX_SAMPLE_R11.q);
      WHEN 0 => SERIAL_R[].d = (GND,SERIAL_R[11..1].q);
    END CASE;
    DAC_LAUNCH_R.clk = CT2; DAC_LAUNCH_R.d = SERIAL_R0.q;
    DAC_DATA_R.clk = !CT2; DAC_DATA_R.d = DAC_LAUNCH_R.q;
    (DAC_LAUNCH_R.ena,DAC_DATA_R.ena) = VCC;
    (DAC_LAUNCH_R.clrn,DAC_DATA_R.clrn) = VCC;
    (DAC_LAUNCH_R.prn,DAC_DATA_R.prn) = VCC;
    DAC_DATA = DAC_DATA_R.q; DAC_BCK = DAC_BCK_R.q; DAC_WS = DAC_WS_R.q;
END;
