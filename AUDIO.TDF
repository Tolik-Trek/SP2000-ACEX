-- Covox buffer and serial DAC datapath. Explicit LCELL, fanout replicas and derived clock inputs are retained.
-- Named control/data banks and preserved physical helpers; independent source review pending.
INCLUDE "lpm_ram_dp";
INCLUDE "lpm_ram_dq";
SUBDESIGN audio
(
	/WR : INPUT;
	D[7..0] : INPUT;
	A[15..0] : INPUT;
	TG42 : INPUT;
	CT[5..0] : INPUT;
	CTH[5..0] : INPUT;
	DCPP[7..0] : INPUT;
	AY_AX[7..0] : INPUT;
	AY_DQX[3..0] : INPUT;
	AY_TONE23_SLOT : INPUT;
	AY_TONE12_SLOT : INPUT;
	AY_SAMPLE_END : INPUT;
	AY_SAMPLE_START : INPUT;
	AY_PHASE2_FALL : INPUT;
	IO_WINDOW : INPUT;
	PORT_XXX01001 : INPUT;
	PORT_XXX01000 : INPUT;
	CBL_CNT[7..0] : OUTPUT;
	DAC_WS_D : OUTPUT;
	DAC_DATA_FALL : OUTPUT;
	DAC_BCK_D : OUTPUT;
	CBL_ENABLE : OUTPUT;
	CBL_WRITE_CLOCK : OUTPUT;
)
VARIABLE
	CBL_CNT[7..0] : NODE;
	CBL : lpm_ram_dp WITH (lpm_width=11,lpm_widthad=8);
	CBL_Q[10..0] : NODE;
	AY_LEVEL[8..0] : NODE;
	AY_SUM_L[10..0] : NODE;
	AY_SUM_R[10..0] : NODE;
	AY_SAMPLE_L[9..0] : NODE;
	AY_SAMPLE_R[9..0] : NODE;
	AY_CHANNEL[9..0] : NODE;
	AUDIO_SAMPLE[11..0] : NODE;
	AUDIO_R[11..0] : NODE;
	AY_ACC_L_ENA : NODE;
	AY_ACC_R_ENA : NODE;
	DAC_WS_D : NODE;
	AY_L_CARRY1 : NODE;
	AY_L_CARRY2 : NODE;
	AY_L_CARRY3 : NODE;
	AY_L_NOR3 : NODE;
	AY_L_CARRY4_N : NODE;
	AY_L_CARRY5 : NODE;
	AY_L_NOR5 : NODE;
	AY_L_CARRY6_N : NODE;
	AY_L_CARRY7 : NODE;
	AY_L_NOR7 : NODE;
	AY_L_CARRY8_N : NODE;
	AY_L_CARRY9 : NODE;
	AY_R_CARRY1 : NODE;
	AY_R_CARRY2 : NODE;
	AY_R_CARRY3 : NODE;
	AY_R_NOR3 : NODE;
	AY_R_CARRY4_N : NODE;
	AY_R_CARRY5 : NODE;
	AY_R_NOR5 : NODE;
	AY_R_CARRY6_N : NODE;
	AY_R_CARRY7 : NODE;
	AY_R_NOR7 : NODE;
	AY_R_CARRY8_N : NODE;
	AY_R_CARRY9 : NODE;
	AUDIO_CARRY4_N : NODE;
	AUDIO_PAIR3_XOR : NODE;
	AUDIO_PAIR3_OR : NODE;
	AUDIO_CARRY2 : NODE;
	AUDIO_CARRY6_N : NODE;
	AUDIO_PAIR5_XOR : NODE;
	AUDIO_PAIR5_OR : NODE;
	AUDIO_CARRY8_N : NODE;
	AUDIO_PAIR7_XOR : NODE;
	AUDIO_PAIR7_OR : NODE;
	AUDIO_CARRY10_N : NODE;
	AUDIO_LOAD : NODE;
	DAC_DATA_RISE : NODE;
	DAC_DATA_FALL : NODE;
	DAC_BCK_D : NODE;
	CBL_WA[7..0] : NODE;
	CBL_DIV_DONE : NODE;
	CBL_ENABLE : NODE;
	CBL_DIV_RESET : NODE;
	CBL_DIV[2..0] : NODE;
	CBL_COUNT_CARRY1 : CARRY;
	CBL_COUNT_CARRY2 : CARRY;
	CBL_COUNT_CARRY3 : CARRY;
	CBL_COUNT_CARRY4 : CARRY;
	CBL_COUNT_CARRY5 : CARRY;
	CBL_COUNT_CARRY6 : CARRY;
	CBL_WRITE_DECODE_D : NODE;
	CBL_WREN : NODE;
	CBL_WRITE_CLOCK : NODE;
	CBL_PORT_ENA : NODE;
	-- Explicit instances preserve FF source names across module ports.
	AUDIO_LOAD_R : DFFE;
	AUDIO_R_R[11..0] : DFFE;
	AUDIO_SAMPLE_R[11..0] : DFFE;
	AY_ACC_L_ENA_R : DFFE;
	AY_ACC_R_ENA_R : DFFE;
	AY_CHANNEL_R[9..0] : DFFE;
	AY_LEVEL_R[8..0] : DFFE;
	AY_SAMPLE_L_R[9..0] : DFFE;
	AY_SAMPLE_R_R[9..0] : DFFE;
	AY_SUM_L_R[10..0] : DFFE;
	AY_SUM_R_R[10..0] : DFFE;
	CBL_CNT_R[7..0] : DFFE;
	CBL_DIV_R[2..0] : DFFE;
	CBL_DIV_RESET_R : DFFE;
	CBL_ENABLE_R : DFFE;
	CBL_PORT_ENA_R : DFFE;
	CBL_WRITE_CLOCK_R : DFFE;
	CBL_WRITE_DECODE_D_R : DFFE;
	DAC_BCK_D_R : DFFE;
	DAC_DATA_FALL_R : DFFE;
	DAC_DATA_RISE_R : DFFE;
	DAC_WS_D_R : DFFE;

	AY_L_CARRY_IN[10..0] : NODE;

	AY_R_CARRY_IN[10..0] : NODE;

	CBL_COUNT_TOGGLE[7..0] : NODE;

BEGIN

    -- Shared physical carry/decoder prefixes of the bank contracts below.
    -- All equations are parallel; LCELL/CASCADE/CARRY topology is retained.
    AY_L_CARRY2 = LCELL((AY_SUM_L[1] & AY_LEVEL[1]) or (AY_LEVEL[1] & AY_SUM_L[0] & AY_LEVEL[0]) or (AY_SUM_L[1] & AY_SUM_L[0] & AY_LEVEL[0]));
    AY_L_CARRY1 = LCELL(AY_LEVEL[0] & AY_SUM_L[0]);
    AY_R_CARRY1 = LCELL(AY_SUM_R[0] & AY_LEVEL[0]);
    AY_R_CARRY2 = LCELL((AY_SUM_R[1] & AY_LEVEL[1]) or (AY_LEVEL[1] & AY_LEVEL[0] & AY_SUM_R[0]) or (AY_SUM_R[1] & AY_LEVEL[0] & AY_SUM_R[0]));
    AY_R_CARRY4_N = LCELL(((!AY_SUM_R[2] & !AY_LEVEL[2]) or (!AY_LEVEL[2] & !AY_R_CARRY2) or (!AY_SUM_R[2] & !AY_R_CARRY2) or AY_R_NOR3) & CASCADE(!AY_SUM_R[3] or !AY_LEVEL[3]));
    AY_R_NOR3 = LCELL(!AY_SUM_R[3] & !AY_LEVEL[3]);
    AY_R_CARRY3 = LCELL((AY_LEVEL[2] & AY_SUM_R[2]) or (AY_LEVEL[2] & AY_R_CARRY2) or (AY_R_CARRY2 & AY_SUM_R[2]));
    AY_R_CARRY7 = LCELL((AY_LEVEL[6] & AY_SUM_R[6]) or (AY_LEVEL[6] & !AY_R_CARRY6_N) or (!AY_R_CARRY6_N & AY_SUM_R[6]));
    AY_L_CARRY7 = LCELL((AY_LEVEL[6] & AY_SUM_L[6]) or (AY_LEVEL[6] & !AY_L_CARRY6_N) or (!AY_L_CARRY6_N & AY_SUM_L[6]));
    AY_L_CARRY4_N = LCELL(((!AY_SUM_L[2] & !AY_LEVEL[2]) or (!AY_LEVEL[2] & !AY_L_CARRY2) or (!AY_SUM_L[2] & !AY_L_CARRY2) or AY_L_NOR3) & CASCADE(!AY_SUM_L[3] or !AY_LEVEL[3]));
    AY_L_NOR3 = LCELL(!AY_SUM_L[3] & !AY_LEVEL[3]);
    AY_L_CARRY3 = LCELL((AY_LEVEL[2] & AY_SUM_L[2]) or (AY_LEVEL[2] & AY_L_CARRY2) or (AY_L_CARRY2 & AY_SUM_L[2]));
    AY_L_CARRY6_N = LCELL(((!AY_SUM_L[4] & !AY_LEVEL[4]) or (!AY_LEVEL[4] & AY_L_CARRY4_N) or (!AY_SUM_L[4] & AY_L_CARRY4_N) or AY_L_NOR5) & CASCADE(!AY_SUM_L[5] or !AY_LEVEL[5]));
    AY_L_NOR5 = LCELL(!AY_SUM_L[5] & !AY_LEVEL[5]);
    AY_L_CARRY5 = LCELL((AY_LEVEL[4] & AY_SUM_L[4]) or (AY_LEVEL[4] & !AY_L_CARRY4_N) or (!AY_L_CARRY4_N & AY_SUM_L[4]));
    AY_R_NOR5 = LCELL(!AY_SUM_R[5] & !AY_LEVEL[5]);
    AY_R_CARRY5 = LCELL((AY_LEVEL[4] & AY_SUM_R[4]) or (AY_LEVEL[4] & !AY_R_CARRY4_N) or (!AY_R_CARRY4_N & AY_SUM_R[4]));
    AY_R_CARRY6_N = LCELL(((!AY_SUM_R[4] & !AY_LEVEL[4]) or (!AY_LEVEL[4] & AY_R_CARRY4_N) or (!AY_SUM_R[4] & AY_R_CARRY4_N) or AY_R_NOR5) & CASCADE(!AY_SUM_R[5] or !AY_LEVEL[5]));
    AY_L_NOR7 = LCELL(!AY_SUM_L[7] & !AY_LEVEL[7]);
    AY_L_CARRY8_N = LCELL(((!AY_LEVEL[6] & !AY_SUM_L[6]) or (!AY_LEVEL[6] & AY_L_CARRY6_N) or (!AY_SUM_L[6] & AY_L_CARRY6_N) or AY_L_NOR7) & CASCADE(!AY_SUM_L[7] or !AY_LEVEL[7]));
    AY_L_CARRY9 = LCELL((AY_LEVEL[8] & AY_SUM_L[8]) or (AY_LEVEL[8] & !AY_L_CARRY8_N) or (!AY_L_CARRY8_N & AY_SUM_L[8]));
    AY_R_NOR7 = LCELL(!AY_SUM_R[7] & !AY_LEVEL[7]);
    AY_R_CARRY8_N = LCELL(((!AY_LEVEL[6] & !AY_SUM_R[6]) or (!AY_LEVEL[6] & AY_R_CARRY6_N) or (!AY_SUM_R[6] & AY_R_CARRY6_N) or AY_R_NOR7) & CASCADE(!AY_SUM_R[7] or !AY_LEVEL[7]));
    AY_R_CARRY9 = LCELL((AY_LEVEL[8] & AY_SUM_R[8]) or (AY_LEVEL[8] & !AY_R_CARRY8_N) or (!AY_R_CARRY8_N & AY_SUM_R[8]));
    CBL_COUNT_CARRY1 = CBL_CNT[1] & CBL_CNT[0];
    CBL_COUNT_CARRY2 = CBL_CNT[2] & CBL_COUNT_CARRY1;
    CBL_COUNT_CARRY3 = CBL_CNT[3] & CBL_COUNT_CARRY2;
    CBL_COUNT_CARRY4 = CBL_CNT[4] & CBL_COUNT_CARRY3;
    CBL_COUNT_CARRY5 = CBL_CNT[5] & CBL_COUNT_CARRY4;
    CBL_COUNT_CARRY6 = CBL_CNT[6] & CBL_COUNT_CARRY5;

    -- CBL read address: CTH2 rising, asynchronous clear while disabled.
    -- It increments modulo256 only at divider terminal0. The enable remains
    -- on the D mux; the original FF ena=VCC and CARRY chain are preserved.
    CBL_COUNT_TOGGLE[] = (CBL_COUNT_CARRY6,CBL_COUNT_CARRY5,
      CBL_COUNT_CARRY4,CBL_COUNT_CARRY3,CBL_COUNT_CARRY2,
      CBL_COUNT_CARRY1,CBL_CNT[0],VCC);
    CASE CBL_DIV_DONE IS
      WHEN 0 => CBL_CNT_R[].d = CBL_CNT[];
      WHEN 1 => CBL_CNT_R[].d = CBL_CNT[] xor CBL_COUNT_TOGGLE[];
    END CASE;

    -- AY stereo accumulation: eleven-bit unsigned sum, modulo2048.
    -- TG42 rising, separate registered left/right slot enables; asynchronous
    -- clear at AY_SAMPLE_START. These controls remain on the real FF banks.
    -- Sample banks capture sum/2; CTH1 selects the stereo time slot.
    -- OLD_AHDL/SP2000/AY.TDF:321-339 contains the identical amplitude table.
    AY_L_CARRY_IN[] = ((AY_L_CARRY9 & AY_SUM_L[9]),AY_L_CARRY9,!AY_L_CARRY8_N,AY_L_CARRY7,!AY_L_CARRY6_N,AY_L_CARRY5,!AY_L_CARRY4_N,AY_L_CARRY3,AY_L_CARRY2,AY_L_CARRY1,GND);
    AY_SUM_L_R[].d = AY_SUM_L[] xor (GND,GND,AY_LEVEL[]) xor AY_L_CARRY_IN[];
    AY_R_CARRY_IN[] = ((AY_R_CARRY9 & AY_SUM_R[9]),AY_R_CARRY9,!AY_R_CARRY8_N,AY_R_CARRY7,!AY_R_CARRY6_N,AY_R_CARRY5,!AY_R_CARRY4_N,AY_R_CARRY3,AY_R_CARRY2,AY_R_CARRY1,GND);
    AY_SUM_R_R[].d = AY_SUM_R[] xor (GND,GND,AY_LEVEL[]) xor AY_R_CARRY_IN[];
    -- Carry-prefix LCELL/CASCADE equations below preserve the native shared
    -- physical prefix tree; no extra registers or resource padding are added.
    AY_SAMPLE_L_R[].d = AY_SUM_L[10..1];
    AY_SAMPLE_R_R[].d = AY_SUM_R[10..1];
    CASE CTH[1] IS
      WHEN 0 => AY_CHANNEL_R[].d = AY_SAMPLE_R[];
      WHEN 1 => AY_CHANNEL_R[].d = AY_SAMPLE_L[];
    END CASE;

	-- AY amplitude table recovered from all nine raw LUT truth tables.
	CASE AY_DQX[] IS
		WHEN 0 => AY_LEVEL_R[].d = 0;
		WHEN 1 => AY_LEVEL_R[].d = 2;
		WHEN 2 => AY_LEVEL_R[].d = 4;
		WHEN 3 => AY_LEVEL_R[].d = 6;
		WHEN 4 => AY_LEVEL_R[].d = 8;
		WHEN 5 => AY_LEVEL_R[].d = 11;
		WHEN 6 => AY_LEVEL_R[].d = 16;
		WHEN 7 => AY_LEVEL_R[].d = 22;
		WHEN 8 => AY_LEVEL_R[].d = 32;
		WHEN 9 => AY_LEVEL_R[].d = 45;
		WHEN 10 => AY_LEVEL_R[].d = 64;
		WHEN 11 => AY_LEVEL_R[].d = 90;
		WHEN 12 => AY_LEVEL_R[].d = 127;
		WHEN 13 => AY_LEVEL_R[].d = 180;
		WHEN 14 => AY_LEVEL_R[].d = 255;
		WHEN 15 => AY_LEVEL_R[].d = 360;
	END CASE;

	CBL_DIV_R[].prn = VCC;

	CBL_DIV_R[].clrn = VCC;

	CBL_DIV_R[].ena = VCC;

	CBL_DIV_R[].clk = CTH[2];

	CBL_CNT_R[].prn = VCC;

	CBL_CNT_R[].clrn = CBL_ENABLE;

	CBL_CNT_R[].ena = VCC;

	CBL_CNT_R[].clk = CTH[2];

	AY_SUM_R_R[].prn = VCC;

	AY_SUM_R_R[].clrn = !AY_SAMPLE_START;

	AY_SUM_R_R[].ena = AY_ACC_R_ENA;

	AY_SUM_R_R[].clk = TG42;

	AY_SUM_L_R[].prn = VCC;

	AY_SUM_L_R[].clrn = !AY_SAMPLE_START;

	AY_SUM_L_R[].ena = AY_ACC_L_ENA;

	AY_SUM_L_R[].clk = TG42;

	AY_SAMPLE_R_R[].prn = VCC;

	AY_SAMPLE_R_R[].clrn = VCC;

	AY_SAMPLE_R_R[].ena = VCC;

	AY_SAMPLE_R_R[].clk = AY_SAMPLE_END;

	AY_SAMPLE_L_R[].prn = VCC;

	AY_SAMPLE_L_R[].clrn = VCC;

	AY_SAMPLE_L_R[].ena = VCC;

	AY_SAMPLE_L_R[].clk = AY_SAMPLE_END;

	AY_LEVEL_R[].prn = VCC;

	AY_LEVEL_R[].clrn = VCC;

	AY_LEVEL_R[].ena = VCC;

	AY_LEVEL_R[].clk = TG42;

	AY_CHANNEL_R[].prn = VCC;

	AY_CHANNEL_R[].clrn = VCC;

	AY_CHANNEL_R[].ena = VCC;

	AY_CHANNEL_R[].clk = TG42;

	AUDIO_SAMPLE_R[].prn = VCC;

	AUDIO_SAMPLE_R[].clrn = VCC;

	AUDIO_SAMPLE_R[].ena = VCC;

	AUDIO_SAMPLE_R[].clk = !CTH[0];

	AUDIO_R_R[].prn = VCC;

	AUDIO_R_R[].clrn = VCC;

	AUDIO_R_R[].ena = AY_PHASE2_FALL;

	AUDIO_R_R[].clk = TG42;

	AY_ACC_L_ENA_R.d = AY_TONE12_SLOT;
	AY_ACC_L_ENA_R.clk = TG42;
	AY_ACC_L_ENA_R.clrn = VCC;
	AY_ACC_L_ENA_R.prn = VCC;
	AY_ACC_L_ENA_R.ena = VCC;

	DAC_WS_D_R.d = !CTH[1];
	DAC_WS_D_R.clk = TG42;
	DAC_WS_D_R.clrn = VCC;
	DAC_WS_D_R.prn = VCC;
	DAC_WS_D_R.ena = VCC;

	AUDIO_CARRY4_N = LCELL(((!AY_CHANNEL[2] & !AUDIO_CARRY2) or (!AY_CHANNEL[2] & !CBL_Q[8]) or (!AUDIO_CARRY2 & !CBL_Q[8]) or !AUDIO_PAIR3_OR) & CASCADE(!CBL_Q[1] or !AY_CHANNEL[3]));

	AUDIO_PAIR3_XOR = LCELL((!CBL_Q[1] & AY_CHANNEL[3]) or (CBL_Q[1] & !AY_CHANNEL[3]));
	AUDIO_SAMPLE_R[3].d = (AY_CHANNEL[2] & !CBL_Q[8] & !AUDIO_CARRY2) or (!AY_CHANNEL[2] & !CBL_Q[8] & AUDIO_CARRY2) or (!AY_CHANNEL[2] & CBL_Q[8] & !AUDIO_CARRY2) or (AY_CHANNEL[2] & CBL_Q[8] & AUDIO_CARRY2);

	AUDIO_SAMPLE_R[4].d = (AY_CHANNEL[2] & AUDIO_CARRY2 & !AUDIO_PAIR3_XOR) or (!AY_CHANNEL[2] & !AUDIO_CARRY2 & AUDIO_PAIR3_XOR) or (AY_CHANNEL[2] & !AUDIO_PAIR3_XOR & CBL_Q[8]) or (!AY_CHANNEL[2] & AUDIO_PAIR3_XOR & !CBL_Q[8]) or (AUDIO_CARRY2 & !AUDIO_PAIR3_XOR & CBL_Q[8]) or (!AUDIO_CARRY2 & AUDIO_PAIR3_XOR & !CBL_Q[8]);

	AUDIO_PAIR3_OR = LCELL(CBL_Q[1] or AY_CHANNEL[3]);
	AUDIO_CARRY2 = LCELL((AY_CHANNEL[1] & AY_CHANNEL[0] & CBL_Q[7]) or (AY_CHANNEL[1] & CBL_Q[3]) or (AY_CHANNEL[0] & CBL_Q[7] & CBL_Q[3]));

	AUDIO_SAMPLE_R[1].d = (AY_CHANNEL[0] & !CBL_Q[7]) or (!AY_CHANNEL[0] & CBL_Q[7]);

	AUDIO_SAMPLE_R[2].d = (AY_CHANNEL[0] & !AY_CHANNEL[1] & !CBL_Q[3] & CBL_Q[7]) or (AY_CHANNEL[0] & AY_CHANNEL[1] & CBL_Q[3] & CBL_Q[7]) or (!AY_CHANNEL[0] & AY_CHANNEL[1] & !CBL_Q[3]) or (!AY_CHANNEL[0] & !AY_CHANNEL[1] & CBL_Q[3]) or (AY_CHANNEL[1] & !CBL_Q[3] & !CBL_Q[7]) or (!AY_CHANNEL[1] & CBL_Q[3] & !CBL_Q[7]);

	AUDIO_CARRY6_N = LCELL(((!AY_CHANNEL[4] & !CBL_Q[6]) or (!AY_CHANNEL[4] & AUDIO_CARRY4_N) or (!CBL_Q[6] & AUDIO_CARRY4_N) or !AUDIO_PAIR5_OR) & CASCADE(!CBL_Q[0] or !AY_CHANNEL[5]));

	AUDIO_SAMPLE_R[6].d = (!AY_CHANNEL[4] & AUDIO_PAIR5_XOR & !CBL_Q[6]) or (AY_CHANNEL[4] & !AUDIO_PAIR5_XOR & CBL_Q[6]) or (AY_CHANNEL[4] & !AUDIO_PAIR5_XOR & !AUDIO_CARRY4_N) or (!AY_CHANNEL[4] & AUDIO_PAIR5_XOR & AUDIO_CARRY4_N) or (!AUDIO_PAIR5_XOR & !AUDIO_CARRY4_N & CBL_Q[6]) or (AUDIO_PAIR5_XOR & AUDIO_CARRY4_N & !CBL_Q[6]);

	AUDIO_SAMPLE_R[5].d = (!AY_CHANNEL[4] & !AUDIO_CARRY4_N & !CBL_Q[6]) or (AY_CHANNEL[4] & !AUDIO_CARRY4_N & CBL_Q[6]) or (AY_CHANNEL[4] & AUDIO_CARRY4_N & !CBL_Q[6]) or (!AY_CHANNEL[4] & AUDIO_CARRY4_N & CBL_Q[6]);

	AUDIO_PAIR5_XOR = LCELL((!CBL_Q[0] & AY_CHANNEL[5]) or (CBL_Q[0] & !AY_CHANNEL[5]));
	AUDIO_PAIR5_OR = LCELL(CBL_Q[0] or AY_CHANNEL[5]);
	AUDIO_SAMPLE_R[0].d = CBL_Q[5];

	AUDIO_R_R[6].d = (AUDIO_SAMPLE[6] & AUDIO_LOAD) # (AUDIO_R[5] & !AUDIO_LOAD);

	AUDIO_R_R[0].d = AUDIO_SAMPLE[0] & AUDIO_LOAD;

	AUDIO_R_R[1].d = (AUDIO_SAMPLE[1] & AUDIO_LOAD) # (AUDIO_R[0] & !AUDIO_LOAD);

	AUDIO_R_R[2].d = (AUDIO_SAMPLE[2] & AUDIO_LOAD) # (AUDIO_R[1] & !AUDIO_LOAD);

	AUDIO_R_R[3].d = (AUDIO_SAMPLE[3] & AUDIO_LOAD) # (AUDIO_R[2] & !AUDIO_LOAD);

	AUDIO_R_R[4].d = (AUDIO_SAMPLE[4] & AUDIO_LOAD) # (AUDIO_R[3] & !AUDIO_LOAD);

	AUDIO_R_R[5].d = (AUDIO_SAMPLE[5] & AUDIO_LOAD) # (AUDIO_R[4] & !AUDIO_LOAD);

	CBL_WA[0] = LCELL(CBL_ENABLE & !A[8]);
	AY_ACC_R_ENA_R.d = AY_TONE23_SLOT;
	AY_ACC_R_ENA_R.clk = TG42;
	AY_ACC_R_ENA_R.clrn = VCC;
	AY_ACC_R_ENA_R.prn = VCC;
	AY_ACC_R_ENA_R.ena = VCC;
	CBL_WA[1] = LCELL(CBL_ENABLE & !A[9]);
	CBL_WA[4] = LCELL(CBL_ENABLE & !A[12]);
	CBL_WA[5] = LCELL(CBL_ENABLE & !A[13]);
	CBL_DIV_R[0].d = (!CBL_DIV[0] & !CBL_DIV_RESET & !CBL_DIV[1]) or (!CBL_DIV[0] & !CBL_DIV[1] & CBL_DIV[2]) or (CBL_DIV[0] & CBL_DIV[1]);

	CBL_DIV_DONE = LCELL(!CBL_DIV[2] & !CBL_DIV[1] & !CBL_DIV[0]);
	CBL_DIV_R[1].d = (!CBL_DIV[1] & CBL_DIV[2]) or (!CBL_DIV[1] & CBL_DIV[0]);

	CBL_DIV_R[2].d = (CBL_DIV[2] & CBL_DIV[0]) or (!CBL_DIV[2] & !CBL_DIV[1] & !CBL_DIV[0]) or (CBL_DIV[2] & CBL_DIV[1]);

	CBL_WA[6] = LCELL(CBL_ENABLE & !A[14]);
	AUDIO_SAMPLE_R[7].d = (!AY_CHANNEL[6] & !AUDIO_CARRY6_N & !CBL_Q[9]) or (AY_CHANNEL[6] & !AUDIO_CARRY6_N & CBL_Q[9]) or (AY_CHANNEL[6] & AUDIO_CARRY6_N & !CBL_Q[9]) or (!AY_CHANNEL[6] & AUDIO_CARRY6_N & CBL_Q[9]);

	AUDIO_R_R[7].d = (AUDIO_SAMPLE[7] & AUDIO_LOAD) # (AUDIO_R[6] & !AUDIO_LOAD);

	AUDIO_SAMPLE_R[8].d = (!AY_CHANNEL[6] & AUDIO_PAIR7_XOR & !CBL_Q[9]) or (AY_CHANNEL[6] & !AUDIO_PAIR7_XOR & CBL_Q[9]) or (AY_CHANNEL[6] & !AUDIO_PAIR7_XOR & !AUDIO_CARRY6_N) or (!AY_CHANNEL[6] & AUDIO_PAIR7_XOR & AUDIO_CARRY6_N) or (!AUDIO_PAIR7_XOR & !AUDIO_CARRY6_N & CBL_Q[9]) or (AUDIO_PAIR7_XOR & AUDIO_CARRY6_N & !CBL_Q[9]);

	AUDIO_R_R[8].d = (AUDIO_SAMPLE[8] & AUDIO_LOAD) # (AUDIO_R[7] & !AUDIO_LOAD);

	AUDIO_R_R[9].d = (AUDIO_SAMPLE[9] & AUDIO_LOAD) # (AUDIO_R[8] & !AUDIO_LOAD);

	AUDIO_R_R[11].d = (AUDIO_SAMPLE[11] & AUDIO_LOAD) # (AUDIO_R[10] & !AUDIO_LOAD);

	AUDIO_R_R[10].d = (AUDIO_SAMPLE[10] & AUDIO_LOAD) # (AUDIO_R[9] & !AUDIO_LOAD);

	AUDIO_CARRY8_N = LCELL(((!AY_CHANNEL[6] & !CBL_Q[9]) or (!AY_CHANNEL[6] & AUDIO_CARRY6_N) or !AUDIO_PAIR7_OR or (AUDIO_CARRY6_N & !CBL_Q[9])) & CASCADE(!CBL_Q[4] or !AY_CHANNEL[7]));
	AUDIO_PAIR7_XOR = LCELL((!CBL_Q[4] & AY_CHANNEL[7]) or (CBL_Q[4] & !AY_CHANNEL[7]));

	AUDIO_PAIR7_OR = LCELL(CBL_Q[4] or AY_CHANNEL[7]);
	AUDIO_CARRY10_N = LCELL((!AY_CHANNEL[8] & !CBL_Q[10]) or (!AY_CHANNEL[8] & AUDIO_CARRY8_N) or (AUDIO_CARRY8_N & !CBL_Q[10]));
	AUDIO_SAMPLE_R[9].d = (!AY_CHANNEL[8] & !AUDIO_CARRY8_N & !CBL_Q[10]) or (AY_CHANNEL[8] & !AUDIO_CARRY8_N & CBL_Q[10]) or (AY_CHANNEL[8] & AUDIO_CARRY8_N & !CBL_Q[10]) or (!AY_CHANNEL[8] & AUDIO_CARRY8_N & CBL_Q[10]);

	AUDIO_SAMPLE_R[11].d = (!AY_CHANNEL[9] & !CBL_Q[2]) or (AUDIO_CARRY10_N & !AY_CHANNEL[9]) or (AUDIO_CARRY10_N & !CBL_Q[2]);

	AUDIO_SAMPLE_R[10].d = (!AUDIO_CARRY10_N & !AY_CHANNEL[9] & !CBL_Q[2]) or (!AUDIO_CARRY10_N & AY_CHANNEL[9] & CBL_Q[2]) or (AUDIO_CARRY10_N & AY_CHANNEL[9] & !CBL_Q[2]) or (AUDIO_CARRY10_N & !AY_CHANNEL[9] & CBL_Q[2]);

	CBL_ENABLE_R.d = D[7];
	CBL_ENABLE_R.clk = CBL_WRITE_CLOCK;
	CBL_ENABLE_R.clrn = VCC;
	CBL_ENABLE_R.prn = VCC;
	CBL_ENABLE_R.ena = CBL_PORT_ENA;
	CBL_PORT_ENA_R.d = PORT_XXX01001 & !DCPP[5] & !DCPP[6] & DCPP[7];
	CBL_PORT_ENA_R.clk = TG42;
	CBL_PORT_ENA_R.clrn = VCC;
	CBL_PORT_ENA_R.prn = VCC;
	CBL_PORT_ENA_R.ena = VCC;
	CBL_DIV_RESET_R.d = D[0];
	CBL_DIV_RESET_R.clk = CBL_WRITE_CLOCK;
	CBL_DIV_RESET_R.clrn = VCC;
	CBL_DIV_RESET_R.prn = VCC;
	CBL_DIV_RESET_R.ena = CBL_PORT_ENA;
	CBL_WRITE_CLOCK_R.d = !IO_WINDOW or /WR;
	CBL_WRITE_CLOCK_R.clk = TG42;
	CBL_WRITE_CLOCK_R.clrn = VCC;
	CBL_WRITE_CLOCK_R.prn = VCC;
	CBL_WRITE_CLOCK_R.ena = VCC;
	DAC_DATA_RISE_R.d = AUDIO_R[11];
	DAC_DATA_RISE_R.clk = CT[2];
	DAC_DATA_RISE_R.clrn = VCC;
	DAC_DATA_RISE_R.prn = VCC;
	DAC_DATA_RISE_R.ena = VCC;
	DAC_DATA_FALL_R.d = DAC_DATA_RISE;
	DAC_DATA_FALL_R.clk = !CT[2];
	DAC_DATA_FALL_R.clrn = VCC;
	DAC_DATA_FALL_R.prn = VCC;
	DAC_DATA_FALL_R.ena = VCC;
	DAC_BCK_D_R.d = CT[2];
	DAC_BCK_D_R.clk = TG42;
	DAC_BCK_D_R.clrn = VCC;
	DAC_BCK_D_R.prn = VCC;
	DAC_BCK_D_R.ena = VCC;
	CBL_WA[7] = LCELL(CBL_ENABLE & !A[15]);
	CBL_WRITE_DECODE_D_R.d = PORT_XXX01000 & DCPP[7] & !DCPP[5] & !DCPP[6];
	CBL_WRITE_DECODE_D_R.clk = TG42;
	CBL_WRITE_DECODE_D_R.clrn = VCC;
	CBL_WRITE_DECODE_D_R.prn = VCC;
	CBL_WRITE_DECODE_D_R.ena = VCC;
	CBL_WREN = LCELL(CBL_WRITE_DECODE_D & !CBL_WRITE_CLOCK);
	CBL_WA[3] = LCELL(CBL_ENABLE & !A[11]);
	CBL_WA[2] = LCELL(CBL_ENABLE & !A[10]);

	AUDIO_LOAD_R.d = CT[4] & CT[5] & CTH[0] & CT[3];
	AUDIO_LOAD_R.clk = CT[2];
	AUDIO_LOAD_R.clrn = VCC;
	AUDIO_LOAD_R.prn = VCC;
	AUDIO_LOAD_R.ena = VCC;

	CBL.data[] = (D[6], D[4], D[0], AY_AX[6], D[2], AY_AX[6], D[5], AY_AX[6], D[7], D[1], D[3]);
	CBL.wraddress[] = (CBL_WA[7], CBL_WA[6], CBL_WA[5], CBL_WA[4], CBL_WA[3], CBL_WA[2], CBL_WA[1], CBL_WA[0]);
	CBL.rdaddress[] = (CBL_CNT[7], CBL_CNT[6], CBL_CNT[5], CBL_CNT[4], CBL_CNT[3], CBL_CNT[2], CBL_CNT[1], CBL_CNT[0]);
	CBL.wren = CBL_WREN;
	CBL.wrclock = TG42;
	CBL.wrclken = VCC;
	CBL.rden = VCC;
	CBL.rdclock = TG42;
	CBL.rdclken = VCC;
	CBL_Q[0] = CBL.q[0];
	CBL_Q[1] = CBL.q[1];
	CBL_Q[2] = CBL.q[2];
	CBL_Q[3] = CBL.q[3];
	CBL_Q[4] = CBL.q[4];
	CBL_Q[5] = CBL.q[5];
	CBL_Q[6] = CBL.q[6];
	CBL_Q[7] = CBL.q[7];
	CBL_Q[8] = CBL.q[8];
	CBL_Q[9] = CBL.q[9];
	CBL_Q[10] = CBL.q[10];

	-- Combinational Q aliases: no extra FF, LCELL or delay.
	AUDIO_LOAD = AUDIO_LOAD_R.q;
	AUDIO_R[] = AUDIO_R_R[].q;
	AUDIO_SAMPLE[] = AUDIO_SAMPLE_R[].q;
	AY_ACC_L_ENA = AY_ACC_L_ENA_R.q;
	AY_ACC_R_ENA = AY_ACC_R_ENA_R.q;
	AY_CHANNEL[] = AY_CHANNEL_R[].q;
	AY_LEVEL[] = AY_LEVEL_R[].q;
	AY_SAMPLE_L[] = AY_SAMPLE_L_R[].q;
	AY_SAMPLE_R[] = AY_SAMPLE_R_R[].q;
	AY_SUM_L[] = AY_SUM_L_R[].q;
	AY_SUM_R[] = AY_SUM_R_R[].q;
	CBL_CNT[] = CBL_CNT_R[].q;
	CBL_DIV[] = CBL_DIV_R[].q;
	CBL_DIV_RESET = CBL_DIV_RESET_R.q;
	CBL_ENABLE = CBL_ENABLE_R.q;
	CBL_PORT_ENA = CBL_PORT_ENA_R.q;
	CBL_WRITE_CLOCK = CBL_WRITE_CLOCK_R.q;
	CBL_WRITE_DECODE_D = CBL_WRITE_DECODE_D_R.q;
	DAC_BCK_D = DAC_BCK_D_R.q;
	DAC_DATA_FALL = DAC_DATA_FALL_R.q;
	DAC_DATA_RISE = DAC_DATA_RISE_R.q;
	DAC_WS_D = DAC_WS_D_R.q;
END;
