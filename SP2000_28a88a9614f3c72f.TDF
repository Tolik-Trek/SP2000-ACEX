
	TITLE "Main";

PARAMETERS
	(
	MODE 	= "SPRINTER",
	NMI_ON	= "OFF",
	SCREEN_OFF = "NOT_USE"
	);

INCLUDE "lpm_ram_dp";
INCLUDE "kbd";

INCLUDE "video2";

INCLUDE	"dcp";

INCLUDE "acceler";
INCLUDE "ay";
INCLUDE "audio";
INCLUDE "mouse";

SUBDESIGN SP2000_28a88a9614f3c72f
	(
	TG42		: INPUT;
	CLKZ1		: OUTPUT;

	/WAIT		: BIDIR;
	/RESET		: BIDIR;
	/M1			: INPUT;
	/RF			: INPUT;
	/IO			: INPUT;
	/WR			: INPUT;
	/RD			: INPUT;
	/HALT		: INPUT;
	/MR			: INPUT;
	A[15..0]	: INPUT;
	D[7..0]		: BIDIR;

	CS_ROM		: OUTPUT;
	CS_CASH		: OUTPUT;
	RA[17..14]	: OUTPUT;

	V_CS[1..0]	: OUTPUT;
	VA[15..0]	: OUTPUT;
	V_WR[3..0]	: OUTPUT;
	VD3[7..0]	: BIDIR;
	VD2[7..0]	: BIDIR;
	VD1[7..0]	: BIDIR;
	VD0[7..0]	: BIDIR;

	WR_COL		: OUTPUT;

	DAC_DATA	: OUTPUT;
	DAC_WS		: OUTPUT;
	DAC_BCK		: OUTPUT;

	MD[15..0]	: BIDIR;
	MA[14..0]	: OUTPUT;
	RAS_[1..0]	: OUTPUT;
	CAS_[3..0]	: OUTPUT;
	/WE			: OUTPUT;

	XACS		: OUTPUT;
	XA[2..0]	: BIDIR;
	XA3			: INPUT;
	SXA			: OUTPUT;

	RDXA		: OUTPUT;
	WR_AWG		: OUTPUT;
	RD_KMPS		: OUTPUT;
	WR_DWG		: OUTPUT;

	)
VARIABLE

	MS			: MOUSE;
	KEYS		: KBD;
	SVIDEO		: VIDEO2 WITH (MODE=MODE);

	DECODE		: DCP;

	ACC			: ACCELER;
	AY3			: AY;

	CBL			: lpm_ram_dp WITH (lpm_width=11,lpm_widthad=8);
    CT[5..0] : NODE;

    CTH[5..0] : NODE;

    CTV[8..0] : NODE;

    CTF[6..0] : NODE;

    CLK42 : NODE;

    DVD3[7..0] : NODE;

    DVD2[7..0] : NODE;

    DVD1[7..0] : NODE;

    DVD0[7..0] : NODE;

    DMD[15..0] : NODE;

    DMDX[7..0] : NODE;

    COPY_SINC_H : NODE;

    COPY_SINC_V : NODE;

    START_UP : NODE;

    BLANK : NODE;

    NMI_X : NODE;

    INT_X : NODE;

    TURBO : NODE;

    KBD_CX : NODE;

    KBD_DX : NODE;

    TAPE_OUT : NODE;

    KBD_CC : NODE;

    KBD_DD : NODE;

    TAPE_IN : NODE;

    MOUSE_D : NODE;

    FDD_CH : NODE;

    FDD_W : NODE;

    SINC_1 : NODE;

    SINC_2 : NODE;

    WR_TM9 : NODE;

    TEST_SWITCH : NODE;

    T_SIGNAL : NODE;

    K_DATA[10..0] : NODE;

    KEY_D[10..0] : DFF;

    KEY_WRITE : NODE;

    KD[7..0] : DFF;

    K_XOR : NODE;

    NEXT_K : NODE;

    RED[7..0] : NODE;

    GREEN[7..0] : NODE;

    BLUE[7..0] : NODE;

    BORDER[7..0] : NODE;

    KBD_BLK : NODE;

    DCPP[7..0] : NODE;

    RGMOD[7..0] : DFFE;

    HDDR[7..0] : DFFE;

    GLISSER : NODE;

    VIDEO_PG : NODE;

    CBL_WR : NODE;

    CBL_IST : NODE;

    INTW_STB : NODE;

    INTW_S6 : NODE;

    INTW_PA : NODE;

    INTW_PB : NODE;

    INTW_PC : NODE;

    INTW_P1 : NODE;

    INTW_P2 : NODE;

    INTW_P3 : NODE;

    INTW_C1 : NODE;

    INTW_D4 : NODE;

    INTW_PAT : NODE;

    INT_WIN : NODE;

    ALL_MODE[7..0] : NODE;

    DOUBLE_CAS : NODE;

    KEMPS[7..0] : LCELL;

    V_WRXX[3..0] : LCELL;

    V_WRX[3..0] : LCELL;

    KEY_IO : NODE;

    /IOWR : NODE;

    T_RDXA : NODE;

    DCP_VAEN : NODE;

    DCP_VWST : NODE;

    RAS_BUFFER0, RAS_BUFFER1 : NODE;

	SOUND : audio;
    SOFT_COUNT_R[1..0] : DFFE;

    START_V_PIPE_R[1..0] : DFFE;

    START_H_SEEN_R, RESET_RELEASE_R, COLOR_FORCE_ONE, COLOR_OUTPUT_WORD_BIT : NODE;

BEGIN

-- OLD SP2_1K30:259..273 soft reset counter: saturates3 on positive CTH2; async reset-window clear.
SOFT_COUNT_R[].clk = CTH2;
SOFT_COUNT_R[].clrn = DECODE.SOFT_COUNT_CLEAR_N;
SOFT_COUNT_R[].ena = VCC;
IF SOFT_COUNT_R[] == 3 THEN SOFT_COUNT_R[] = 3;
ELSE SOFT_COUNT_R[] = SOFT_COUNT_R[] + 1; END IF;
-- Startup: capture H first, then two V_RESYNC-qualified TG42 stages. Separate enables are actual hardware.
START_V_PIPE_R[].clk = CLK42;
START_V_PIPE_R[].ena = SVIDEO.V_RESYNC;
START_V_PIPE_R[] = (START_V_PIPE_R0,START_H_SEEN_R);

    BORDER[4..0] = DECODE.BORDER_LATCH[]; BORDER[7..5] = GND;
    SVIDEO.BORDER_BITS[] = DECODE.BORDER_LATCH[2..0];
    KEYS.KB_SCAN_COUNT[] = DECODE.KB_SCAN_COUNT[];
    DECODE.KB_RELEASE = KEYS.KB_RELEASE;
    DECODE.KB_EXT_PREFIX = KEYS.KB_EXT_PREFIX;

	RAS_BUFFER0 = LCELL(DECODE.RASQ);
	RAS_BUFFER1 = LCELL(DECODE.RASQ);
	DECODE.KB_RECEIVE_BITS[] = KEYS.KB_RECEIVE_BITS[];
	DECODE.KB_RECEIVE_COUNT_N[] = KEYS.KB_RECEIVE_COUNT_N[];

	ALL_MODE[0] = !DECODE.ALL_MODE0_N;
	ALL_MODE[7..1] = GND;

	SVIDEO.MA_PHASE[] = DECODE.MA_PHASE[];
	SVIDEO.XA_READ_PHASE = DECODE.XA_READ_PHASE;
	SVIDEO.XA_HALF_CYCLE = DECODE.XA_HALF_CYCLE;
	SVIDEO.VRAM_CAPTURE_A[] = DECODE.VRAM_CAPTURE_A[];
	SVIDEO.VRAM_CAPTURE_B[] = DECODE.VRAM_CAPTURE_B[];

	CLK42		= TG42;

	START_H_SEEN_R		= DFFE(VCC, CLK42,,, SVIDEO.H_RESYNC);

	RESET_RELEASE_R		= DFFE(SOFT_COUNT_R[0] & !DECODE.KEY_RESET_INHIBIT_R & START_V_PIPE_R[1] & SOFT_COUNT_R[1], CLK42,,,);
	/RESET		= TRI(GND, !RESET_RELEASE_R);

	/IOWR = DECODE.IO_WRITE_PHASE;

	KEYS.int_ena	= ALL_MODE0;
	KEYS.ena		= !ALL_MODE0;

	KEYS.clk42 = CLK42;
 KEYS.KB_RAW_CLOCK = DECODE.KB_RX_CLOCK;
 KEYS.KB_COUNT_CLOCK = CTH5;
 DECODE.KB_ONE_TICK = KEYS.KB_ONE_TICK;
	KEYS.clk_k	= DFF(CTH5,CLK42,,);
	KEYS.kbd_cc	= KBD_CC or !KBD_BLK;
	KEYS.kbd_dd	= KBD_DD;

	KD[].clk	= CLK42;
	NEXT_K	= TFF(VCC,KEY_WRITE,,);

	CASE (NEXT_K) IS
		WHEN 0 => KD[] = H"ED";
		WHEN 1 => KD[] = (B"00000",CTF[6..4]);
	END CASE;

	K_XOR	= !(KD7 xor KD6 xor KD5 xor KD4 xor KD3 xor KD2 xor KD1 xor KD0);
	K_DATA[]	= (VCC,K_XOR,KD[],GND);

	KEY_D[].clk		= KBD_CC;
	KEY_D[].d		= (GND,KEY_D[10..1]);

	FOR i in 0 to 10 GENERATE
		KEY_D[i].prn		= K_DATA[i] or KEY_WRITE;
	END GENERATE;
	KEY_D[].clrn	= /RESET;

	KEY_WRITE		= DFF((!DFF(CTF1,CLK42,,) or CTF1),CLK42,,);

	KBD_BLK		= VCC;
	KBD_DX		= GND;

	HDDR[].clk	= LCELL(/WR & (/RD or DECODE./IOMM));
	HDDR[].ena  = (DECODE.HDD_DATA & !DECODE./IOM);

	CASE DFF(/WR,!DECODE.RASQ,,) IS
		WHEN 0 => HDDR[].d = D[];
		WHEN 1 => HDDR[].d = MD[15..8];
	END CASE;

	DMDX[] = DECODE.MD_LOW_OUT[];

	ACC.HDDR[] 		= HDDR[];
	ACC.HDD_FLIP	= DECODE.HDD_FLIP;

	V_WRXX[] = !SVIDEO.V_WEN[];

  	V_WRX3 = !SVIDEO.V_WEN3;
  	V_WRX2 = !SVIDEO.V_WEN2;
  	V_WRX1 = !SVIDEO.V_WEN1;
  	V_WRX0 = !SVIDEO.V_WEN0;

	FOR i IN 0 TO 7 GENERATE
		D[i]	= TRI(DECODE.DMUX[i],DECODE.DOE);
		VD3[i] = TRI(DVD3[i],SVIDEO.V_WEN3);
		VD2[i] = TRI(DVD2[i],SVIDEO.V_WEN2);
		VD1[i] = TRI(DVD1[i],SVIDEO.V_WEN1);
		VD0[i] = TRI(DVD0[i],SVIDEO.V_WEN0);
		MD[i]	= TRI(DMDX[i],DECODE.MDOE);
		MD[i+8]	= TRI(DECODE.MDQ[i],DECODE.MDOE);

	END GENERATE;

	TEST_SWITCH 	= TFF((!KEYS.kb_sh & !KEYS.kb_ctrl & !KEYS.kb_alt),KEYS.kb_F12,,/RESET);

	KEY_IO		= DFFE((/IO or !/M1),CLK42,,,(CT1 & CT2));
	KEYS./rf = /RF;
	KEYS./iom = /IO;
	KEYS./io = /IO;
	KEYS./m1	= VCC;

	KEYS.a[15..8]	= A[15..8];

	DVD0[]		= SVIDEO.vdo0[];
	DVD1[]		= SVIDEO.vdo1[];
	DVD2[]		= SVIDEO.vdo2[];
	DVD3[]		= SVIDEO.vdo3[];

	V_WR[3..0]	= SVIDEO.V_WR[];

	CS_ROM	= DECODE.CS_ROM;
	XACS	= DECODE.XACQ;

	CS_CASH = DECODE.CSCH;

	RA[]	= DECODE.RA[];

	RD_KMPS		= DECODE.RDKMQ;

	WR_DWG		= DECODE.WR_DWG;

	(KBD_CX)	= GND;

	IF (NMI_ON == "ON") GENERATE
		NMI_X		= (!KEYS.kb_f12 & KEYS.kb_alt);
	ELSE GENERATE
		NMI_X		= GND;
	END GENERATE;

	INT_X		= DFF(VCC,CBL_IST,(DFF(!INT_X,CTH3,,) & (/M1 or /IO)),);

	TAPE_OUT = DECODE.TAPE_OUT;

	RDXA = !DECODE.XA_READ_PHASE;

	T_RDXA = !DECODE.XA_READ_PHASE;

	WR_TM9		= LCELL(CT2);

	SXA = DECODE.XA_HALF_CYCLE;

	WR_AWG		= DECODE.WR_AWG;

	XA0 = TRI(KBD_CX,DECODE.XA_WRITE_ENA);
	XA1 = TRI(KBD_DX,DECODE.XA_AUX_WRITE_ENA);
	XA2 = TRI(TAPE_OUT,DECODE.XA_WRITE_ENA);

	KBD_DD = DECODE.KB_RX_DATA;
	KBD_CC = DECODE.KB_RX_CLOCK;
	TAPE_IN		= DFFE(XA2,T_RDXA,,,!SXA);
	MOUSE_D     = DFFE(XA3,T_RDXA,,,!SXA);

	FDD_CH		= DFFE(XA1,T_RDXA,,,SXA);
	FDD_W	    = DFFE(XA0,T_RDXA,,,SXA);
	SINC_1      = DFFE(XA2,T_RDXA,DECODE./RES,,SXA);
	SINC_2      = DFFE(XA3,T_RDXA,DECODE./RES,,SXA);

	COPY_SINC_H	= DFF(DFF(!SINC_1 & DFF(SINC_1,!CLK42,,),!CLK42,,),CLK42,,);
	COPY_SINC_V	= DFF(DFF(!SINC_2 & DFF(SINC_2,!CLK42,,),!CLK42,,),CLK42,,);

	START_UP	= DFFE(DFFE(DFFE(VCC,CLK42,,,COPY_SINC_H),CLK42,,,COPY_SINC_V),CLK42,,,COPY_SINC_V);

	DCPP[] = DECODE.DCPP[];

	DECODE.CLK42	= CLK42;
	DECODE./RESET	= /RESET;

	DECODE.CT[5..0]	= CT[5..0];
	DECODE.cth[5..0]= CTH[5..0];
	DECODE.XA0		= XA0;
	DECODE.XA1		= XA1;
	DECODE.XA2		= XA2;
	DECODE.XA3		= XA3;
	DECODE.C68		= CTV[8];
	DECODE.UCNT[]	= ACC.UCNT[];
	DECODE.ABAH[]	= ACC.ABAH[];
	DECODE.KDQ[] = (KEYS.KDQ[4],KEYS.KDQ[6],KEYS.KDQ[0],KEYS.KDQ[2],KEYS.KDQ[7],KEYS.KDQ[3],KEYS.KDQ[5],KEYS.KDQ[1]);
	DECODE.AYDQ[]	= AY3.AYDQ[];
	DECODE.AY_READ_CAPTURE_EN		= AY3.AY_READ_CAPTURE_EN;
	ACC.VDWQ[]		= DECODE.VDWQ[];

	DOUBLE_CAS	= ACC.DOUBLE_CAS;

	RAS_[0] = RAS_BUFFER0; RAS_[1] = RAS_BUFFER1;
	CAS_[]	= DECODE.CASQ[];

	/WE		= DECODE.WEQ;

	DECODE.CA[15..0]	= A[];

	DECODE.A[15..0]	= ACC.AO[];
	DECODE.DI[7..0]	= D[];

	MA[11..0]		= DECODE.MA[11..0];
	MA[14..12]		= (!TURBO,INT_X,NMI_X);

	CLKZ1			= DECODE.CLK_Z80;

	TURBO			= DECODE.TURBO;

	DECODE./IO		= /IO;
	DECODE./RD		= /RD;
	DECODE./WR		= /WR;
	DECODE./MR		= /MR;
	DECODE./RF		= /RF;
	DECODE./M1		= /M1;

	/WAIT			= OPNDRN(DECODE./WAIT);

	DECODE.MDX[15..0]	= MD[15..0];

	DCP_VAEN	= DECODE.VA_EN;
	DCP_VWST	= DECODE.VW_STB;

	ACC.ACC_ENA	= ALL_MODE0;

	ACC.CLK42	= CLK42;
	ACC./RESET	= /RESET;
	ACC.CT[2..0]= CT[2..0];
	ACC.CLK_Z80	= DECODE.CLK_Z80;

	ACC.RAS		= VCC;
	ACC.CAS		= DECODE.VW_STB;

	ACC.MC_END	= DECODE.MCENDQ;
	ACC.MC_BEGIN= VCC;
	ACC.MC_TYPE	= DECODE.MTYPEQ;
	ACC.MC_WRITE= VCC;

	ACC.AI[15..0]	= A[];
	ACC.DI[7..0]	= D[];

	ACC./IO		= /IO;
	ACC./RD		= /RD;
	ACC./WR		= /WR;
	ACC./MR		= /MR;
	ACC./RF		= /RF;
	ACC./M1		= /M1;
	ACC./IOM	= DECODE./IOM;

	ACC.DCP[7..0]	= DCPP[];

	ACC.MDI[15..0]	= MD[];

	ACC.U0E		= DECODE.U0_ENA;
	ACC.U1E		= DECODE.U1_ENA;
	ACC.U2E		= DECODE.U2_ENA;
	ACC.USEL	= DECODE.UCNT_SEL;
	ACC.UWRC7	= DECODE.U_WRC7;
	ACC.FRACTION_STEP_EN	= DECODE.ACC_FRACTION_STEP_EN;
	ACC.COUNT_LOAD_EN	= DECODE.ACC_COUNT_LOAD_EN_R;
	ACC.ADDRESS_DOUBLE_STEP	= DECODE.ACC_MD_COPY;

	RGMOD[].clk	= /IOWR;
	RGMOD[].ena	= DFF((DCPP[] == B"1100X101"),CLK42,,);

	RGMOD[].d	= D[];
	RGMOD[].clrn= /RESET;

	DECODE.G_LINE[] = (GND,GND,ACC.G_LINE[7..0]);

	VIDEO_PG	= LCELL(DECODE.PAGE[7..4] == B"0101");

	GLISSER		= LCELL(ACC.GLISSER & DECODE.PAGE[3] & VIDEO_PG);

	SVIDEO.clk42	= CLK42;

	CT[5..0]	= SVIDEO.ct[5..0];
	CTH[5..0]	= SVIDEO.cth[5..0];
	CTV[8..0]	= SVIDEO.ctv[8..0];
	CTF[6..0]	= SVIDEO.ctf[6..0];

	BLANK		= SVIDEO.blank;

	SVIDEO.start_up = VCC;
	SVIDEO.xa2p	= XA2;
	SVIDEO.xa3p	= XA3;

	SVIDEO.wr		= DFF((!DECODE.WEQ or GLISSER or DECODE.VW_STB),!CLK42,,/RESET);

	SVIDEO.VW_STB	= DECODE.VW_STB;
	SVIDEO.VA_EN	= DECODE.VA_EN;
	SVIDEO.VDWCK	= DECODE.MD_READ_END_CLOCK;
	SVIDEO.ACC_RAM_SOURCE	= DECODE.ACC_RAM_SOURCE;
	SVIDEO.ACC_MD_COPY	= DECODE.ACC_MD_COPY;
	SVIDEO.IOX		= /IO;
	SVIDEO.ACCQ[]	= ACC.RAMQ[];
	SVIDEO.MDP[15..8] = MD[15..8];
	SVIDEO.GRFX		= DECODE.GRAF;
	SVIDEO.PHB		= INTW_PB;
	SVIDEO.PHC		= INTW_PA;
	SVIDEO.ACC_CYCLE_N	= DECODE.ACC_CYCLE_N;
	SVIDEO.SCREEN_ROW6_XOR		= DECODE.SCREEN_ROW6_XOR;
	SVIDEO.IVSTB	= INTW_STB;
	SVIDEO.PHA		= INTW_PC;
	SVIDEO.IP2		= INTW_P2;
	SVIDEO.ID4		= INTW_D4;
	SVIDEO.IPAT		= INTW_PAT;
	SVIDEO.IC1		= INTW_C1;

	SVIDEO.vai[]	= (DECODE.GA[],ACC.AO[9..0]);

	VA[]		= SVIDEO.vao[];

	SVIDEO.D[]	= D[];
	SVIDEO.MDI[] = ACC.MDO[];
	SVIDEO.DOUBLE_CAS	= DOUBLE_CAS;

	SVIDEO.VDM0[7..0]	= VD0[];
	SVIDEO.VDM1[7..0]	= VD1[];
	SVIDEO.VDM2[7..0]	= VD2[];
	SVIDEO.VDM3[7..0]	= VD3[];

	V_CS[1..0]	= SVIDEO.v_cs[];
	WR_COL		= DFFE(COLOR_OUTPUT_WORD_BIT,CLK42,,,);

	SVIDEO.ZX_PORT[5..0]	= (ACC.G_LINE[5..0]);
	SVIDEO.ZX_PORT[7..6]	= (DECODE.SP_SA,LCELL(DECODE.SP_SCR & !(A13 & !ACC.G_LINE7) & !ACC.G_LINE6));

	SVIDEO.DIR_PORT[0]		= DECODE.SCR128;

	SVIDEO.DIR_PORT[3] = DECODE.VIDEO_MODE0;

	IF (SCREEN_OFF == "USE") GENERATE
		SVIDEO.DIR_PORT[4]		= RGMOD1;
	ELSE GENERATE
		SVIDEO.DIR_PORT[4]		= GND;
	END GENERATE;

	SVIDEO.DIR_PORT[2..1]	= GND;
	SVIDEO.DIR_PORT[7..5]	= BORDER[2..0];

	SVIDEO.MOUSE_X[]		= MS.OUT_X[];
	SVIDEO.MOUSE_Y[]		= MS.OUT_Y[];

    SOUND.CLK42 = CLK42; SOUND.CT[] = CT[]; SOUND.CTH[] = CTH[1..0];
    SOUND.SAMPLE_SLOT = AY3.AY_CH_VAL;
    SOUND.BIT_CLOCK_DELAY = AY3.BIT_CLOCK_DELAY;
    SOUND.AY_LEFT[] = AY3.AY_CH_L[]; SOUND.AY_RIGHT[] = AY3.AY_CH_R[];
    SOUND.CBL_RAW[] = CBL.q[];
    DAC_DATA = SOUND.DAC_DATA; DAC_BCK = SOUND.DAC_BCK; DAC_WS = SOUND.DAC_WS;

	CBL_WR	= DFF((DCPP[] == B"10001000"),CLK42,,) & !/IOWR;

	CBL.wren 		= CBL_WR;

	CBL.data[] 		= (GND,D4,D0,D2,D6,D3,GND,D5,D7,GND,D1);

	CBL.wraddress[] = (!A[15..8]) & DECODE.CBL_ENABLE_R;

	CBL.wrclock		= CLK42;
	CBL.wrclken		= VCC;
	CBL.rden		= VCC;

	CBL.rdaddress[] = DECODE.CBL_READ_ADDR[];
	CBL.rdclock		= CLK42;
	CBL.rdclken		= VCC;

	CBL_IST			= !DECODE.KEY_READY_N_R & !INT_WIN;

	INTW_S6			= (SVIDEO.ivd3[5] & !CT5) or !CT3;
	INTW_PA			= DFFE(!CT0 & (CT1 $ CT2),CLK42,VCC,VCC,VCC);
	INTW_PB			= DFFE((CT1 or !CT2) & !CT0,CLK42,VCC,VCC,VCC);
	INTW_PC			= DFFE((!CT1 & !CT2 & CT0) or (CT1 & CT2 & !CT0),CLK42,VCC,VCC,VCC);
	INTW_STB		= DFFE(!CT4 or INTW_S6 or !INTW_PA or !INTW_PB,CLK42,VCC,VCC,VCC);

	INTW_P1			= DFFE(INTW_PC or !INTW_PB or INTW_PA,CLK42,VCC,VCC,VCC);
	INTW_P2			= DFFE(INTW_P1,CLK42,VCC,VCC,VCC);
	INTW_P3			= DFFE(SVIDEO.ivd3[5],INTW_P2,VCC,VCC,VCC);
	INTW_C1			= DFFE((INTW_P3 & INTW_PA) or (!INTW_PC & !INTW_PA) or !INTW_PB,CLK42,VCC,VCC,VCC);

	INTW_D4			= DFFE(SVIDEO.ivd3[5] & SVIDEO.ivd3[7] & SVIDEO.ivd3[6] & SVIDEO.ivd3[4],INTW_C1,VCC,VCC,VCC);
	INTW_PAT		= DFFE(INTW_D4 & SVIDEO.ivd3[2] & SVIDEO.ivd3[3],INTW_C1,VCC,VCC,VCC);
	INT_WIN			= DFFE(CTV0 & CTV1 & CTV2 & INTW_PAT,CT5,SVIDEO.ivd30,VCC,VCC);

	COLOR_FORCE_ONE			= LCELL(INTW_PB or INTW_PA);
	COLOR_OUTPUT_WORD_BIT			= LCELL((INTW_P3 & INTW_PC) or (!INTW_PC & SVIDEO.COLOR_ALL_ONES) or COLOR_FORCE_ONE);

	AY3.CLK42		= CLK42;

	AY3./RESET		= /RESET;
	AY3.AY_T[8..0] = (CTH[2],!CTH[1],CTH[0],CT[]);

	AY3.AY_D_WR		= DFF((!DECODE.IO_CYCLE_ACTIVE or /WR) or !DFF((DCPP[] == H"91"),CLK42,,),CLK42,,);
	AY3.AY_A_WR		= DFF((!DECODE.IO_CYCLE_ACTIVE or /WR) or !DFF((DCPP[] == H"90"),CLK42,,),CLK42,,);

	AY3.D[7..0]		= D[];
	AY3.BEEPER		= BORDER4;

	MS.clk		= DFF(CTH5,CLK42,,);
	MS.mouse_d	= MOUSE_D;

	CASE (A10,A8) IS
		WHEN 0,2 => KEMPS[] = (B"111111",!MS.OUT_K0,!MS.OUT_K1);
		WHEN 1 => 	KEMPS[] = (MS.OUT_X[7..0]);
		WHEN 3 => 	KEMPS[] = !(MS.OUT_Y[7..0]);
	END CASE;

END;

