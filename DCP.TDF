	DRAM_WE_OUT_LUT_TERM1 : NODE;

	SCREEN_PAGE_BANK : NODE;
BEGIN

    -- Shared physical carry/decoder prefixes of the bank contracts below.
    -- All equations are parallel; LCELL/CASCADE/CARRY topology is retained.
    WAIT_LOAD_N[2] = LCELL(!WAIT_SEED[2]);
    WAIT_LOAD_N[3] = LCELL(!WAIT_SEED[3]);
    WAIT_LOAD_N[0] = LCELL(!WAIT_SEED[0]);
    WAIT_LOAD_N[1] = LCELL(!WAIT_SEED[1]);

    -- Sampled port decode. DCPP is captured on !TG42; decoders below are
    -- parallel mask comparators. Shared prefix LCELLs and CASCADE boundaries
    -- remain physical because they fan out to independently clocked controls.
    -- OLD_AHDL/SP2000/DCP.TDF:614-626 uses the same Cx/low-three-bit grouping.
    PORT_XXX01111 = LCELL(!DCPP[4] & CASCADE(DCPP[3..0] == 15));
    PORT_XXX01001 = LCELL(!DCPP[4] & CASCADE(DCPP[3..0] == 9));
    PORT_XXX10000 = LCELL(DCPP[4] & CASCADE(DCPP[3..0] == 0));
    PORT_XXX10001 = LCELL(DCPP[4] & CASCADE(DCPP[3..0] == 1));
    PORT_XXX00011 = LCELL(!DCPP[4] & CASCADE(DCPP[3..0] == 3));
    PORT_XXX01000 = LCELL(!DCPP[4] & CASCADE(DCPP[3..0] == 8));
    PORT_44_4C_C4_CC = LCELL((DCPP[6..5] == 2) & CASCADE((DCPP[4],DCPP[2..0]) == 4));
    PORT_C5_CD = LCELL((DCPP[7..4] == 12) & CASCADE(DCPP[2..0] == 5));
    PORT_C2_CA = LCELL((DCPP[7..4] == 12) & CASCADE(DCPP[2..0] == 2));
    PORT_1100XXXX = LCELL(DCPP[7..4] == 12);
    PORT_XXXXX110 = LCELL(DCPP[2..0] == 6);
    PORT_XXXX1011 = LCELL(DCPP[3..0] == 11);
	-- Page3 bank bit: extended paging selects PN6; normal paging selects SC4.
	-- OLD_AHDL/SP2000/DCP.TDF:653, PG3 bit3 (same selector).
	SCREEN_PAGE_BANK = LCELL((CNF[7] & PN[6]) or (!CNF[7] & SC4));

	-- Private physical helper of this bank; one instance, no cross-module cut.
	DRAM_WE_OUT_LUT_TERM1 = LCELL((ACC_DRIVE_FF_D & !PORT_MD_HIGH) or (MD_HIGH_FF_D & PORT_MD_HIGH));

	-- Private physical helper of this bank; one instance, no cross-module cut.
